---
import type { CollectionEntry } from "astro:content";
import InstrumentPhoto from "./InstrumentPhoto.astro";
import { getInstrumentImages, getInstrumentPhotoCrop } from "../lib/instrumentImages";
import { withBasePath } from "../lib/sitePaths";
import { instrumentStatusLabels } from "../lib/instrumentAvailability";
interface Props {
  instrument: CollectionEntry<"instruments">;
  variant?: "default" | "compact" | "archive" | "summary";
}
const { instrument, variant = "default" } = Astro.props;
const { data } = instrument;
const archive = variant === "archive";
const images = getInstrumentImages(instrument.filePath ?? instrument.id, data.title, data);
const instrumentUrl = withBasePath(`/instruments/${data.slug}/`);
const construction = ["SB-200", "SB-300", "SB-800", "SB-1000"].includes(data.model)
  ? "Fully carved" : ["SB-150", "SB-180"].includes(data.model) ? "Hybrid" : "Laminated";
const facts = [construction, data.size, data.year?.toString()].filter(Boolean).join(" · ");
---
<article class="w-full max-w-[400px]">
  <a href={instrumentUrl} aria-label={`View ${data.title}`} class="block focus-visible:outline-2 focus-visible:outline-offset-4">
    <div class:list={["mx-auto w-full", archive ? "max-w-[190px]" : "max-w-[260px]"]}>
      {images.hero ? (
        <InstrumentPhoto image={images.hero} crop={getInstrumentPhotoCrop(data.inventory, images.hero)}
          sizes={archive ? "190px" : "260px"} />
      ) : <div class="grid aspect-[2/3] place-items-center bg-neutral-100 text-sm text-neutral-500">Photographs to follow</div>}
    </div>
  </a>
  <div class="border-t border-neutral-200 pt-5 mt-5">
    <p class="text-xs text-neutral-500">{instrumentStatusLabels[data.status]}</p>
    <h3 class="subsection-title mt-2"><a href={instrumentUrl} class="hover:underline underline-offset-4">{data.title}</a></h3>
    <p class="mt-3 text-sm text-neutral-600">{facts}</p>
    {!archive && <p class="mt-3 text-sm leading-relaxed text-neutral-600">{data.shortDescription}</p>}
    <a href={instrumentUrl} class="quiet-link mt-5">{archive ? "View reference" : "View instrument"}</a>
  </div>
</article>
