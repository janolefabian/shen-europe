---
import type { CollectionEntry } from "astro:content";
import { getInstrumentImages } from "../lib/instrumentImages";

interface Props {
  instrument: CollectionEntry<"instruments">;
}

const { instrument } = Astro.props;
const { data } = instrument;

const images = getInstrumentImages(
  instrument.filePath ?? instrument.id,
  data.title,
);

const statusLabels = {
  available: "Available",
  reserved: "Reserved",
  "coming-soon": "Coming soon",
  sold: "Sold",
} as const;

const statusDots = {
  available: "bg-emerald-600",
  reserved: "bg-amber-500",
  "coming-soon": "bg-sky-600",
  sold: "bg-neutral-400",
} as const;

const instrumentUrl = `/instruments/${data.slug}/`;
---

<article class="group">
  <a
    href={instrumentUrl}
    class="block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-950 focus-visible:ring-offset-4"
    aria-label={`View ${data.title}`}
  >
    <div class="aspect-[3/4] overflow-hidden bg-neutral-100">
      {
        images.hero ? (
          <img
            src={images.hero.src}
            alt={images.hero.alt}
            loading="lazy"
            class="h-full w-full object-cover object-center transition duration-500 ease-out group-hover:scale-[1.015]"
          />
        ) : (
          <div class="flex h-full items-center justify-center text-sm text-neutral-400">
            Image coming soon
          </div>
        )
      }
    </div>
  </a>

  <div class="pt-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm text-neutral-500">
          {data.model} · {data.outline}
        </p>

        <h2 class="mt-2 font-serif text-3xl leading-tight tracking-[-0.025em] text-neutral-950">
          <a href={instrumentUrl} class="transition-opacity hover:opacity-55">
            {data.title}
          </a>
        </h2>
      </div>

      <span class="inline-flex shrink-0 items-center gap-2 rounded-full border border-neutral-200 px-3 py-1.5 text-xs font-medium text-neutral-700">
        <span class:list={["size-1.5 rounded-full", statusDots[data.status]]} aria-hidden="true"></span>
        {statusLabels[data.status]}
      </span>
    </div>

    <p class="mt-5 max-w-xl text-base leading-relaxed text-neutral-600">
      {data.shortDescription}
    </p>

    <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-neutral-200 pt-5 text-sm sm:grid-cols-3">
      {data.price && (
        <div>
          <dt class="text-neutral-500">Price</dt>
          <dd class="mt-1 text-neutral-950">{data.price}</dd>
        </div>
      )}

      <div>
        <dt class="text-neutral-500">Location</dt>
        <dd class="mt-1 text-neutral-950">{data.location}</dd>
      </div>

      {data.stringLength && (
        <div>
          <dt class="text-neutral-500">String length</dt>
          <dd class="mt-1 text-neutral-950">{data.stringLength}</dd>
        </div>
      )}
    </dl>

    <a
      href={instrumentUrl}
      class="mt-7 inline-block border-b border-neutral-950 pb-1 text-sm font-medium text-neutral-950 transition-opacity hover:opacity-55"
    >
      View instrument
    </a>
  </div>
</article>
