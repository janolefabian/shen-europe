---
import type { CollectionEntry } from "astro:content";
import { getInstrumentImages } from "../lib/instrumentImages";

interface Props {
  instrument: CollectionEntry<"instruments">;
}

const { instrument } = Astro.props;
const { data } = instrument;

const folder = instrument.id.replace(/\/index$/, "");
const images = getInstrumentImages(folder, data.title);

const statusLabels = {
  available: "Available",
  reserved: "Reserved",
  "coming-soon": "Coming soon",
  sold: "Sold",
};
---

<article>
  <a href={`/instruments/${data.slug}/`} class="group block">
    <div class="aspect-[4/5] overflow-hidden bg-neutral-100">
      {
        images.hero ? (
          <img
            src={images.hero.src}
            alt={images.hero.alt}
            class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.015]"
          />
        ) : (
          <div class="flex h-full items-center justify-center text-sm text-neutral-400">
            Image coming soon
          </div>
        )
      }
    </div>

    <div class="pt-5">
      <div class="flex items-start justify-between gap-5">
        <div>
          <p class="text-sm text-neutral-500">
            {data.model} · {data.outline}
          </p>

          <h2 class="mt-2 font-serif text-3xl leading-tight tracking-[-0.025em] text-neutral-950">
            {data.title}
          </h2>
        </div>

        <span class="shrink-0 text-sm text-neutral-500">
          {statusLabels[data.status]}
        </span>
      </div>

      <p class="mt-4 max-w-xl text-base leading-relaxed text-neutral-600">
        {data.shortDescription}
      </p>

      <div class="mt-5 flex flex-wrap gap-x-7 gap-y-2 text-sm">
        {data.price && <span>{data.price}</span>}
        <span class="text-neutral-500">{data.location}</span>
      </div>
    </div>
  </a>
</article>
