---
import type { CollectionEntry } from "astro:content";

interface Props {
  instrument: CollectionEntry<"instruments">;
}

const { instrument } = Astro.props;
const { data } = instrument;

const statusLabels = {
  available: "Available",
  reserved: "Reserved",
  "coming-soon": "Coming soon",
  sold: "Sold",
} as const;

const statusClasses = {
  available: "bg-emerald-50 text-emerald-800 ring-emerald-200",
  reserved: "bg-amber-50 text-amber-800 ring-amber-200",
  "coming-soon": "bg-blue-50 text-blue-800 ring-blue-200",
  sold: "bg-neutral-100 text-neutral-600 ring-neutral-200",
} as const;

const instrumentUrl = `/instruments/${instrument.id}/`;
---

<article class="group">
  <a
    href={instrumentUrl}
    class="block overflow-hidden bg-neutral-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-950 focus-visible:ring-offset-4"
  >
    <div class="aspect-[4/5] overflow-hidden">
      <img
        src={data.heroImage}
        alt={data.heroImageAlt}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.015]"
      />
    </div>
  </a>

  <div class="pt-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm text-neutral-500">
          {data.model} · {data.outline}
        </p>

        <h2 class="mt-2 font-serif text-3xl leading-tight tracking-[-0.025em] text-neutral-950">
          <a href={instrumentUrl} class="transition-opacity hover:opacity-55">
            {data.title}
          </a>
        </h2>
      </div>

      <span
        class:list={[
          "inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ring-1 ring-inset",
          statusClasses[data.status],
        ]}
      >
        {statusLabels[data.status]}
      </span>
    </div>

    <p class="mt-5 max-w-xl text-base leading-relaxed text-neutral-600">
      {data.shortDescription}
    </p>

    <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-neutral-200 pt-5 text-sm">
      <div>
        <dt class="text-neutral-500">Location</dt>
        <dd class="mt-1 text-neutral-950">{data.location}</dd>
      </div>

      {data.stringLength && (
        <div>
          <dt class="text-neutral-500">String length</dt>
          <dd class="mt-1 text-neutral-950">{data.stringLength}</dd>
        </div>
      )}

      {data.price && (
        <div>
          <dt class="text-neutral-500">Price</dt>
          <dd class="mt-1 text-neutral-950">{data.price}</dd>
        </div>
      )}
    </dl>

    <div class="mt-7">
      <a
        href={instrumentUrl}
        class="inline-block border-b border-neutral-950 pb-1 text-sm font-medium transition-opacity hover:opacity-55"
      >
        View instrument
      </a>
    </div>
  </div>
</article>
