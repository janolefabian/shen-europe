---
interface Props {
  videoId: string;
  title: string;
}

const { videoId, title } = Astro.props;
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?rel=0`;
---

<div class="aspect-video overflow-hidden bg-neutral-950">
  <iframe
    src={embedUrl}
    title={title}
    class="h-full w-full"
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
  ></iframe>
</div>
