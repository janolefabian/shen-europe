---
import Stack from "./layout/Stack.astro";
import Button from "./ui/Button.astro";
import Heading from "./ui/Heading.astro";
import Text from "./ui/Text.astro";
import sb800FrontImage from "../content/instruments/bass-0003/hero.png";
---

<section class="bg-white">
  <div
    class="grid min-h-[calc(100vh-88px)] grid-cols-1 lg:min-h-[calc(100vh-108px)] lg:grid-cols-2"
  >
    <div
      class="flex items-center px-5 py-16 sm:px-8 sm:py-20 lg:px-12 xl:px-14"
    >
      <Stack gap="lg" class="max-w-[660px]">
        <Heading as="h1" size="hero">
          Samuel Shen <br />
          Double Basses <br />
          in Europe
        </Heading>

        <Text size="lg" class="max-w-[610px]">
          Samuel Shen double basses selected in Suzhou, set up in Berlin and
          available for trial or order in Europe.
        </Text>

        <div>
          <Button
            href="/available"
            variant="text"
            class="border-b-2 pb-2 text-xs font-semibold tracking-[0.11em] uppercase sm:text-sm"
          >
            View available instruments
          </Button>
        </div>
      </Stack>
    </div>

    <div class="min-h-[62vh] overflow-hidden lg:min-h-[calc(100vh-108px)]">
      <img
        src={sb800FrontImage.src}
        alt="Front view of the available SB-800 Shen Classic 3/4 double bass"
        class="h-full w-full object-cover object-center"
      />
    </div>
  </div>
</section>
