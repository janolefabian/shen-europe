---
interface Props {
  as?: "div" | "section" | "article" | "ul" | "ol";
  class?: string;
  gap?: "xs" | "sm" | "md" | "lg" | "xl";
  align?: "start" | "center" | "end" | "stretch";
}

const {
  as: Tag = "div",
  class: className = "",
  gap = "md",
  align = "stretch",
} = Astro.props;

const gaps = {
  xs: "gap-2",
  sm: "gap-4",
  md: "gap-8",
  lg: "gap-12",
  xl: "gap-16 lg:gap-20",
};

const alignments = {
  start: "items-start",
  center: "items-center",
  end: "items-end",
  stretch: "items-stretch",
};
---

<Tag class:list={["flex flex-col", gaps[gap], alignments[align], className]}>
  <slot />
</Tag>
