---
interface Props {
  as?: "div" | "section" | "main" | "header" | "footer" | "nav";
  class?: string;
  size?: "wide" | "content" | "narrow";
}

const { as: Tag = "div", class: className = "", size = "wide" } = Astro.props;

const widths = {
  wide: "max-w-[var(--container-wide)]",
  content: "max-w-6xl",
  narrow: "max-w-3xl",
};
---

<Tag
  class:list={[
    "mx-auto w-full",
    "px-[var(--spacing-page-mobile)]",
    "sm:px-[var(--spacing-page-tablet)]",
    "lg:px-[var(--spacing-page-desktop)]",
    widths[size],
    className,
  ]}
>
  <slot />
</Tag>
