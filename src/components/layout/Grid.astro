---
interface Props {
  as?: "div" | "section" | "ul";
  class?: string;
  columns?: 1 | 2 | 3 | 4;
  gap?: "sm" | "md" | "lg";
}

const {
  as: Tag = "div",
  class: className = "",
  columns = 3,
  gap = "md",
} = Astro.props;

const columnClasses = {
  1: "grid-cols-1",
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
};

const gaps = { sm: "gap-4", md: "gap-6 lg:gap-8", lg: "gap-8 lg:gap-12" };
---

<Tag class:list={["grid", columnClasses[columns], gaps[gap], className]}>
  <slot />
</Tag>
