---
interface Props {
  as?: "div" | "nav" | "ul";
  class?: string;
  gap?: "xs" | "sm" | "md" | "lg";
  justify?: "start" | "center" | "between" | "end";
  align?: "start" | "center" | "end";
  wrap?: boolean;
}

const {
  as: Tag = "div",
  class: className = "",
  gap = "md",
  justify = "start",
  align = "center",
  wrap = true,
} = Astro.props;

const gaps = { xs: "gap-2", sm: "gap-4", md: "gap-6", lg: "gap-10" };
const justifications = {
  start: "justify-start",
  center: "justify-center",
  between: "justify-between",
  end: "justify-end",
};
const alignments = { start: "items-start", center: "items-center", end: "items-end" };
---

<Tag
  class:list={[
    "flex",
    wrap ? "flex-wrap" : "flex-nowrap",
    gaps[gap],
    justifications[justify],
    alignments[align],
    className,
  ]}
>
  <slot />
</Tag>
