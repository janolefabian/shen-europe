---
interface Props {
  class?: string;
  ratio?: "equal" | "text-wide" | "media-wide";
  reverseOnMobile?: boolean;
  align?: "start" | "center" | "end";
  gap?: "md" | "lg" | "xl";
}

const {
  class: className = "",
  ratio = "equal",
  reverseOnMobile = false,
  align = "center",
  gap = "lg",
} = Astro.props;

const ratios = {
  equal: "lg:grid-cols-2",
  "text-wide": "lg:grid-cols-[1.15fr_0.85fr]",
  "media-wide": "lg:grid-cols-[0.85fr_1.15fr]",
};
const alignments = { start: "items-start", center: "items-center", end: "items-end" };
const gaps = { md: "gap-8", lg: "gap-12 lg:gap-16", xl: "gap-16 lg:gap-24" };
---

<div
  class:list={[
    "grid grid-cols-1",
    ratios[ratio],
    alignments[align],
    gaps[gap],
    reverseOnMobile && "[&>*:first-child]:order-2 lg:[&>*:first-child]:order-1 [&>*:last-child]:order-1 lg:[&>*:last-child]:order-2",
    className,
  ]}
>
  <slot />
</div>
