---
import Container from "./Container.astro";

interface Props {
  as?: "section" | "div" | "aside";
  class?: string;
  containerClass?: string;
  containerSize?: "wide" | "content" | "narrow";
  spacing?: "none" | "sm" | "md" | "lg" | "xl";
  contained?: boolean;
}

const {
  as: Tag = "section",
  class: className = "",
  containerClass = "",
  containerSize = "wide",
  spacing = "lg",
  contained = true,
} = Astro.props;

const spacingClasses = {
  none: "",
  sm: "py-10 sm:py-14",
  md: "py-14 sm:py-20 lg:py-24",
  lg: "py-20 sm:py-24 lg:py-32",
  xl: "py-24 sm:py-32 lg:py-40",
};
---

<Tag class:list={[spacingClasses[spacing], className]}>
  {
    contained ? (
      <Container size={containerSize} class={containerClass}>
        <slot />
      </Container>
    ) : (
      <slot />
    )
  }
</Tag>
