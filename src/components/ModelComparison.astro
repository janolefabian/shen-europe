---
import { modelOutlineDefinitions } from '../lib/modelOutlines';
import { comparisonModels, bodyTransform, formatCm } from '../lib/modelComparison';
import { comparisonCatalogue, comparisonSections, availableComparisonInstruments } from '../lib/comparisonCatalogue';
import { getInstruments } from '../lib/instruments';
import { withBasePath } from '../lib/sitePaths';
const instruments = await getInstruments();
const initial = comparisonCatalogue[0];
const outline = modelOutlineDefinitions[initial.pattern];
const transform = bodyTransform(initial.body, outline);
---
<section class="model-comparison" aria-label="Explore models and compare body shapes">
  <nav class="construction-nav" aria-label="Jump to construction type">
    {comparisonSections.map(section => <a href={`#compare-${section.id}`}>{section.name}<span aria-hidden="true">↓</span></a>)}
  </nav>
  <div class="comparison-grid">
    <div class="model-list">
      {comparisonSections.map(section => (
        <section class="construction-section" id={`compare-${section.id}`} aria-labelledby={`heading-${section.id}`}>
          <header class="construction-heading" id={section.id}><h2 id={`heading-${section.id}`} class="subsection-title">{section.name}</h2><p>{section.description}</p></header>
          {section.groups.map(group => {
            const entries = comparisonCatalogue.filter(entry => entry.group === group);
            return <div class="material-group">
              {entries[0].material && <h3 class="eyebrow">{entries[0].material}</h3>}
              {entries.map(entry => <div class="model-row">
                <button type="button" class="model-choice" data-entry={entry.id} aria-pressed={entry.id === initial.id}>
                  <span>{entry.name}</span><span class="model-specification">{entry.size} · {entry.levels.join(' · ')}</span>
                </button>
                <button type="button" class="pin-choice" data-pin={entry.id} aria-pressed="false" aria-label={`Pin ${entry.label}, ${entry.construction}${entry.material ? ', '+entry.material : ''}`}>
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 9V3H8v6l-3 3v3h14v-3l-3-3ZM12 15v6" /></svg><span>Pin</span>
                </button>
              </div>)}
            </div>;
          })}
        </section>
      ))}
    </div>
    <div class="stage-home" data-stage-home><div class="instrument-stage">
      <figure class="comparison-figure">
        <svg class="body-drawing" viewBox="0 0 400 500" role="img" aria-labelledby="comparison-title comparison-description">
          <title id="comparison-title">{initial.label} body outline</title>
          <desc id="comparison-description">Body lengths share a scale and lower edge. Widths are estimated from photographs, not verified measurements. Related models share an illustrative contour.</desc>
          <defs>{comparisonModels.map(model => <path data-source={model.key} d={modelOutlineDefinitions[model.key].halfPath} />)}</defs>
          <path class="axis" d="M200 15V465"/><path class="baseline" d="M40 465H360"/>
          <g class="initial-outline" transform={`matrix(${transform.scale} 0 0 ${transform.scale} ${transform.x} ${transform.y})`}>
            <path d={outline.halfPath}/><path d={outline.halfPath} transform={`translate(${2*outline.center} 0) scale(-1 1)`}/>
          </g>
          <g class="motion-trails" aria-hidden="true"><path/><path/><path/></g>
          <path class="current-outline"/><path class="pinned-outline"/>
        </svg>
        <figcaption>
          <div class="current-caption"><span class="line-key" aria-hidden="true"></span><h2 class="subsection-title" data-current-name>{initial.name}</h2></div>
          <p class="caption-context" data-current-context>{initial.construction} · {initial.material} · {initial.levels.join(' · ')}</p>
          <p class="caption-measure" data-current-measure>{formatCm(initial.body)} cm body · {formatCm(initial.string)} cm string length</p>
          <div class="pinned-caption" hidden>
            <span class="line-key dashed" aria-hidden="true"></span><span data-pinned-name></span>
            <button type="button" class="unpin" data-unpin aria-label="Remove pinned comparison">Unpin</button>
          </div>
          <p class="difference" data-difference hidden></p>
          <p class="same-pattern" data-same-pattern hidden>Same illustrated body pattern.</p>
        </figcaption>
      </figure>
      <p class="measurement-note">Body lengths to scale. Widths estimated from photographs.</p>
      <div class="selected-details">
        {comparisonCatalogue.map(entry => {
          const available = availableComparisonInstruments(entry,instruments);
          return <div data-details={entry.id} hidden={entry.id !== initial.id}>
            {available.length > 0 && <div class="available-examples"><span>Available to try</span>{available.map(instrument => <a href={withBasePath(`/instruments/${instrument.data.slug}/`)}>{instrument.data.title} →</a>)}</div>}
            <details class="model-details"><summary>Model details</summary>
              <p>{entry.label} · {entry.construction}{entry.material ? ' · '+entry.material : ''} · {entry.levels.join(' · ')}</p>
              <p>Illustrated outline: {modelOutlineDefinitions[entry.pattern].label}. Reference dimensions describe the illustrated size, not every variant.</p>
              {entry.note && <p>{entry.note}</p>}
              {entry.provisional && <p>Panormo dimensions are a provisional local reference. {modelOutlineDefinitions.panormo.completionNote}</p>}
              <a href={withBasePath(entry.source)}>{entry.provisional ? 'Local model reference' : 'US model specification'} →</a>
            </details>
          </div>;
        })}
      </div>
      <p class="sr-only" aria-live="polite" data-status></p>
    </div></div>
  </div>
  <div class="mobile-comparison-bar">
    <span data-mobile-summary>Choose a model to explore its shape.</span>
    <button type="button" data-open-comparison>Compare shapes ↗</button>
  </div>
  <dialog class="mobile-comparison-dialog" aria-labelledby="mobile-comparison-title">
    <header class="dialog-heading"><h2 id="mobile-comparison-title">Compare shapes</h2><button type="button" data-close-comparison aria-label="Close comparison and return to models">Close <span aria-hidden="true">×</span></button></header>
    <div class="dialog-stage" data-dialog-stage></div>
    <div class="dialog-controls">
      <label for="comparison-model-picker">Model</label>
      <select id="comparison-model-picker" data-model-picker>
        {comparisonSections.flatMap(section => section.groups.map(group => <optgroup label={`${section.name}${group.startsWith('Vollmassiv') ? group.endsWith('Ahorn') ? ' · Maple' : ' · Willow' : ''}`}>
          {comparisonCatalogue.filter(entry=>entry.group===group).map(entry=><option value={entry.id}>{entry.label} · {entry.levels.join(' / ')}</option>)}
        </optgroup>))}
      </select>
      <div class="dialog-actions">
        <button type="button" data-previous-model aria-label="Previous model">←</button>
        <button type="button" data-pin-current aria-pressed="false">Pin this model</button>
        <button type="button" data-next-model aria-label="Next model">→</button>
      </div>
    </div>
  </dialog>
  <details class="comparison-notes"><summary>About the range, measurements &amp; sources</summary>
    <p>The range is grouped by construction, with longer bodies first within each group. SB numbers identify specification levels; they are not a ranking of sound. Related models can share the same illustrated body pattern.</p>
    <p>The catalogue describes model options, not stock availability. “Available to try” links refer to individual instruments currently listed as available.</p>
    <p>The drawings use a shared scale and lower edge, preserving the proportions of the source photographs. They are simplified, symmetrical illustrations, not measured plans. Necks, scrolls and rib depths are not shown. Some models have alternative outlines; the displayed variant is identified in Model details.</p>
    <p>Reference lengths follow the US catalogue, checked on 25 October 2026. Panormo uses a provisional local reference and a schematically completed lower edge.</p>
    <ul>{comparisonCatalogue.map(entry => <li><a href={withBasePath(entry.source)}>{entry.label}</a></li>)}</ul>
  </details>
  <noscript><p>Enable JavaScript to morph and compare the outlines.</p></noscript>
</section>
<script>
  import { modelOutlineDefinitions, type ModelOutlineKey } from '../lib/modelOutlines';
  import { comparisonModels, bodyTransform, formatCm } from '../lib/modelComparison';
  import { comparisonCatalogue } from '../lib/comparisonCatalogue';
  const root = document.querySelector<HTMLElement>('.model-comparison')!;
  const query = <T extends Element = HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
  const mobile=matchMedia('(max-width: 699px)');
  const dialog=query<HTMLDialogElement>('.mobile-comparison-dialog');
  const stage=query('.instrument-stage');
  const stageHome=query('[data-stage-home]');
  let dialogTrigger:HTMLElement|null=null;
  let priorOverflow='';
  function openComparison(trigger:HTMLElement){
    if(!mobile.matches||dialog.open)return;
    dialogTrigger=trigger;
    query('[data-dialog-stage]').append(stage);
    priorOverflow=document.documentElement.style.overflow;
    document.documentElement.style.overflow='hidden';
    dialog.showModal();
    query<HTMLButtonElement>('[data-close-comparison]').focus({preventScroll:true});
  }
  dialog.addEventListener('close',()=>{
    stageHome.append(stage);
    document.documentElement.style.overflow=priorOverflow;
    dialogTrigger?.focus({preventScroll:true});
  });
  query('[data-close-comparison]').addEventListener('click',()=>dialog.close());
  query('[data-open-comparison]').addEventListener('click',event=>openComparison(event.currentTarget as HTMLElement));
  mobile.addEventListener('change',()=>{if(!mobile.matches&&dialog.open)dialog.close();});
  type Point = [number,number];
  const shapes = new Map<ModelOutlineKey,Point[]>();
  for (const model of comparisonModels) {
    const source = query<SVGPathElement>(`[data-source="${model.key}"]`);
    const length = source.getTotalLength();
    const {scale,x,y} = bodyTransform(model.body,modelOutlineDefinitions[model.key]);
    const half: Point[] = Array.from({length:221},(_,i) => { const p=source.getPointAtLength(length*i/220); return [x+p.x*scale,y+p.y*scale]; });
    shapes.set(model.key,half.concat(half.slice(0,-1).reverse().map(([x,y])=>[400-x,y] as Point)));
  }
  const path = (points:Point[]) => 'M'+points.map(p=>p.map(n=>n.toFixed(2)).join(',')).join('L')+'Z';
  const mix = (a:Point[],b:Point[],t:number):Point[] => a.map((p,i)=>[p[0]+(b[i][0]-p[0])*t,p[1]+(b[i][1]-p[1])*t]);
  const ease = (t:number) => 1-Math.pow(1-Math.max(0,Math.min(1,t)),4);
  const entryFor = (id:string) => comparisonCatalogue.find(entry=>entry.id===id)!;
  const context = (id:string) => { const e=entryFor(id); return [e.construction,e.material,...e.levels].filter(Boolean).join(' · '); };
  let selected:string=comparisonCatalogue[0].id, pinned:string|null=null;
  let current=shapes.get(entryFor(selected).pattern)!;
  let frameId=0, announcement:ReturnType<typeof setTimeout>, sameTransition=false, sameAs:string|null=null;
  const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)');
  const main=query<SVGPathElement>('.current-outline');
  const trails=Array.from(root.querySelectorAll<SVGPathElement>('.motion-trails path'));
  function renderLabels() {
    const entry=entryFor(selected);
    query<HTMLSelectElement>('[data-model-picker]').value=selected;
    query<HTMLButtonElement>('[data-previous-model]').disabled=selected===comparisonCatalogue[0].id;
    query<HTMLButtonElement>('[data-next-model]').disabled=selected===comparisonCatalogue.at(-1)!.id;
    query('[data-pin-current]').textContent=pinned===selected?'Unpin this model':'Pin this model';
    query('[data-pin-current]').setAttribute('aria-pressed',String(pinned===selected));
    query('[data-mobile-summary]').textContent=pinned?`Pinned: ${entryFor(pinned).label} · ${entryFor(pinned).construction}`:`${entry.label} · ${entry.construction}`;
    query('[data-current-name]').textContent=entry.name;
    query('[data-current-context]').textContent=context(selected);
    query('[data-current-measure]').textContent=`${formatCm(entry.body)} cm body · ${formatCm(entry.string)} cm string length${entry.provisional?' · provisional':''}`;
    root.querySelectorAll<HTMLButtonElement>('[data-entry]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.entry===selected)));
    root.querySelectorAll<HTMLButtonElement>('[data-pin]').forEach(b=>{
      const active=b.dataset.pin===pinned, e=entryFor(b.dataset.pin!);
      b.setAttribute('aria-pressed',String(active));b.setAttribute('aria-label',`${active?'Unpin':'Pin'} ${e.label}, ${e.construction}${e.material?', '+e.material:''}`);
      b.querySelector('span')!.textContent=active?'Pinned':'Pin';
    });
    root.querySelectorAll<HTMLElement>('[data-details]').forEach(panel=>panel.hidden=panel.dataset.details!==selected);
    query<SVGPathElement>('.pinned-outline').setAttribute('d',pinned?path(shapes.get(entryFor(pinned).pattern)!):'');
    query('.pinned-caption').hidden=!pinned;
    query('[data-difference]').hidden=!pinned;
    query('#comparison-title').textContent=entry.label+(pinned?` compared with ${entryFor(pinned).label}`:' body outline');
    const sharedWithPin=pinned && pinned!==selected && entryFor(pinned).pattern===entry.pattern;
    query('[data-same-pattern]').hidden=!(sameTransition || sharedWithPin);
    query('[data-same-pattern]').textContent=sharedWithPin?'Same illustrated body pattern as the pinned model.':sameAs?`Same illustrated body pattern as ${entryFor(sameAs).label}.`:'';
    if(!pinned)return;
    const reference=entryFor(pinned);
    query('[data-pinned-name]').textContent=`${reference.label} · ${reference.construction}${reference.material?' · '+reference.material:''} · pinned${reference.provisional?' · provisional':''}`;
    const diff=entry.body-reference.body;
    query('[data-difference]').textContent=selected===pinned?'Select another model to compare.':(diff===0?'Same body length':`${formatCm(Math.abs(diff))} cm ${diff>0?'longer':'shorter'}`)+(entry.provisional||reference.provisional?' · provisional':'');
  }
  function select(id:string,animate=true) {
    if(!entryFor(id)||(id===selected&&animate))return;
    const prior=entryFor(selected), next=entryFor(id);
    sameTransition=selected!==id&&prior.pattern===next.pattern;
    sameAs=sameTransition?selected:null;
    selected=id;clearTimeout(announcement);renderLabels();
    // Identical shapes keep still, even when their catalogue names or SB levels change.
    if(!sameTransition||!animate){
      cancelAnimationFrame(frameId);
      const from=current,to=shapes.get(next.pattern)!,start=performance.now();
      const duration=reducedMotion.matches||!animate?0:1000;
      function frame(now:number){
        const t=duration?Math.min(1,(now-start)/duration):1;
        current=mix(from,to,ease(t));main.setAttribute('d',path(current));
        trails.forEach((trail,i)=>{
          const delay=(i+1)*.075,offset=Math.sin(Math.PI*t)*22*(i+1)/3;
          trail.setAttribute('d',path(mix(from,to,ease((t-delay)/(1-delay)))));
          trail.setAttribute('transform',`translate(${offset} ${-offset*.18})`);
          trail.style.opacity=String((1-t)*(pinned ? .14 : .46));
        });
        if(t<1)frameId=requestAnimationFrame(frame);
      }
      frame(start);
    }
    announcement=setTimeout(()=>{query('[data-status]').textContent=query('#comparison-title').textContent;},1050);
  }
  root.querySelectorAll<HTMLButtonElement>('[data-entry]').forEach(button=>{
    const id=button.dataset.entry!;
    button.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'&&!mobile.matches)select(id);});
    button.addEventListener('focus',()=>{if(!mobile.matches)select(id);});
    button.addEventListener('click',()=>{select(id);openComparison(button);});
  });
  function unpin(){pinned=null;renderLabels();clearTimeout(announcement);query('[data-status]').textContent='Comparison unpinned.';}
  root.querySelectorAll<HTMLButtonElement>('[data-pin]').forEach(button=>button.addEventListener('click',()=>{
    const id=button.dataset.pin!;pinned=pinned===id?null:id;renderLabels();clearTimeout(announcement);
    query('[data-status]').textContent=pinned?`${entryFor(pinned).label}, ${entryFor(pinned).construction}, pinned for comparison.`:'Comparison unpinned.';
  }));
  query('[data-unpin]').addEventListener('click',()=>{const prior=pinned;unpin();if(dialog.open){query<HTMLButtonElement>('[data-pin-current]').focus({preventScroll:true});}else{root.querySelectorAll<HTMLButtonElement>('[data-pin]').forEach(b=>{if(b.dataset.pin===prior)b.focus({preventScroll:true});});}});
  query<HTMLSelectElement>('[data-model-picker]').addEventListener('change',event=>select((event.currentTarget as HTMLSelectElement).value));
  for(const [selector,step] of [['[data-previous-model]',-1],['[data-next-model]',1]] as const){
    query(selector).addEventListener('click',()=>{const index=comparisonCatalogue.findIndex(e=>e.id===selected);const next=comparisonCatalogue[index+step];if(next)select(next.id);});
  }
  query('[data-pin-current]').addEventListener('click',()=>{
    pinned=pinned===selected?null:selected;renderLabels();clearTimeout(announcement);
    query('[data-status]').textContent=pinned?`${entryFor(pinned).label} pinned for comparison.`:'Comparison unpinned.';
  });
  reducedMotion.addEventListener('change',()=>{if(reducedMotion.matches)select(selected,false);});
  root.dataset.enhanced='true';
  main.setAttribute('d',path(current));query<SVGGElement>('.initial-outline').style.display='none';renderLabels();
</script>
<style>
  .model-comparison { --comparison-accent:#677346; }
  .stage-home { display:contents; }
  .mobile-comparison-bar { display:none; }
  .mobile-comparison-dialog { padding:0; border:0; color:var(--color-text); background:var(--color-page); }
  .mobile-comparison-dialog::backdrop { background:rgb(0 0 0 / .4); }
  .dialog-heading { position:sticky; top:0; z-index:2; display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.6rem 1.25rem; background:var(--color-page); border-bottom:1px solid var(--color-border); }
  .dialog-heading h2 { font:1.3rem/1.2 var(--font-serif); }
  .dialog-heading button { display:flex; gap:.65rem; align-items:center; min-height:44px; font-size:.8125rem; }
  .dialog-heading button span { font-size:1.5rem; }
  .dialog-stage { padding:0 1.25rem 1rem; }
  .dialog-controls { position:sticky; bottom:0; z-index:2; margin-top:auto; padding:.75rem 1.25rem max(.75rem,env(safe-area-inset-bottom)); background:var(--color-page); border-top:1px solid var(--color-border); }
  .dialog-controls label { display:block; font-size:.75rem; color:#666; margin-bottom:.35rem; }
  .dialog-controls select { width:100%; min-width:0; min-height:44px; border:1px solid #aaa; border-radius:3px; padding:.5rem; background:var(--color-page); font-size:16px; }
  .dialog-actions { display:grid; grid-template-columns:44px minmax(0,1fr) 44px; gap:.75rem; margin-top:.6rem; }
  .dialog-actions button { min-height:44px; border:1px solid var(--color-border); border-radius:3px; font-size:.8125rem; }
  .dialog-actions button:disabled { opacity:.35; cursor:default; }
  .dialog-actions [data-pin-current] { background:#242722; color:white; border-color:#242722; }
  .dialog-actions [data-pin-current][aria-pressed="true"] { background:#eef1e7; color:#4d5c2f; border-color:#aeb89b; }
  .construction-nav { display:flex; flex-wrap:wrap; gap:1rem 2rem; border-block:1px solid var(--color-border); padding-block:1rem; margin-bottom:2rem; font-size:.875rem; }
  .construction-nav a { display:flex; align-items:center; gap:1rem; text-underline-offset:4px; }
  .construction-nav a:hover { text-decoration:underline; }
  .construction-nav span { color:#777; }
  .comparison-grid { display:grid; grid-template-columns:minmax(270px,1fr) minmax(0,1.4fr); gap:clamp(2rem,6vw,6rem); align-items:start; }
  .construction-section,.construction-heading { scroll-margin-top:110px; }
  .construction-section + .construction-section { margin-top:3rem; }
  .construction-heading { margin-bottom:1.25rem; }
  .construction-heading p { color:#666; font-size:.8125rem; line-height:1.6; margin-top:.5rem; max-width:25rem; }
  .material-group + .material-group { margin-top:1.75rem; }
  .material-group h3 { margin-bottom:.5rem; }
  .model-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:.5rem; align-items:center; border-bottom:1px solid var(--color-border); }
  button { cursor:pointer; }
  button:focus-visible,summary:focus-visible,a:focus-visible { outline:2px solid var(--comparison-accent); outline-offset:4px; }
  .model-choice { display:flex; flex-direction:column; align-items:flex-start; gap:.35rem; text-align:left; padding:.9rem 0; min-height:66px; font:1.3rem/1.2 var(--font-serif); color:#777; }
  .model-choice:hover,.model-choice[aria-pressed="true"] { color:var(--color-text); }
  .model-specification { font:.75rem/1.6 var(--font-sans); color:#666; }
  .pin-choice { display:inline-flex; justify-content:center; align-items:center; gap:.4rem; min-height:44px; min-width:76px; padding:.5rem; border:1px solid transparent; border-radius:3px; font-size:.75rem; color:#737373; }
  .pin-choice:hover { border-color:var(--color-border); }
  .pin-choice[aria-pressed="true"] { color:#4d5c2f; border-color:#aeb89b; background:#f0f2e9; }
  .instrument-stage { position:sticky; top:95px; min-width:0; background:var(--color-page); }
  .comparison-figure { margin:0; }
  .body-drawing { display:block; width:100%; height:clamp(260px,49vh,520px); }
  .body-drawing path { vector-effect:non-scaling-stroke; stroke-linejoin:round; stroke-linecap:round; }
  .axis { stroke:#ddd; stroke-width:.6; stroke-dasharray:2 6; }
  .baseline { stroke:#ddd; stroke-width:.7; }
  .initial-outline { fill:none; stroke:#242722; stroke-width:1.6; }
  .current-outline { stroke:#242722; stroke-width:1.6; fill:#e4e6db; fill-opacity:.25; }
  .motion-trails { fill:none; stroke:var(--comparison-accent); stroke-width:1; }
  .pinned-outline { fill:none; stroke:var(--comparison-accent); stroke-width:1.8; stroke-dasharray:7 5; opacity:.9; }
  figcaption { padding-top:.5rem; }
  .current-caption,.pinned-caption { display:flex; flex-wrap:wrap; align-items:baseline; gap:.4rem .65rem; }
  .line-key { width:22px; flex:0 0 22px; border-top:2px solid #242722; }
  .dashed { border-top:2px dashed var(--comparison-accent); }
  .caption-context,.caption-measure,.pinned-caption,.difference,.same-pattern { color:#666; font-size:.75rem; line-height:1.6; margin-top:.35rem; }
  .pinned-caption { margin-top:.65rem; }
  .unpin { text-decoration:underline; text-underline-offset:3px; min-height:30px; }
  [hidden] { display:none!important; }
  .measurement-note { font-size:.6875rem; line-height:1.6; color:#737373; margin-top:.75rem; }
  .selected-details { margin-top:.75rem; }
  .available-examples { display:flex; flex-wrap:wrap; gap:.25rem .75rem; font-size:.75rem; margin-bottom:.65rem; }
  .available-examples > span { color:#666; }
  .available-examples a,.model-details a { text-decoration:underline; text-underline-offset:3px; }
  .model-details { border-top:1px solid var(--color-border); padding-top:.6rem; font-size:.75rem; line-height:1.7; }
  .model-details p { margin-block:.6rem; }
  summary { cursor:pointer; width:fit-content; }
  .comparison-notes { border-top:1px solid var(--color-border); margin-top:2.5rem; padding-top:1rem; font-size:.8125rem; line-height:1.8; color:#666; }
  .comparison-notes p { max-width:52rem; margin-top:.8rem; }
  .comparison-notes ul { display:flex; flex-wrap:wrap; gap:.4rem 1.5rem; margin-top:1rem; }
  .comparison-notes a { text-decoration:underline; text-underline-offset:3px; }
  @media(max-width:699px) {
    .construction-nav { gap:.75rem 1.5rem; margin-bottom:1rem; font-size:.8125rem; }
    .comparison-grid { display:flex; flex-direction:column; gap:1.5rem; }
    .model-comparison[data-enhanced="true"] .stage-home .instrument-stage { display:none; }
    .instrument-stage { position:static; width:100%; }
    .body-drawing { height:clamp(230px,38svh,380px); }
    .mobile-comparison-dialog[open] { display:grid; grid-template-rows:auto minmax(0,1fr) auto; position:fixed; inset:0; margin:0; width:100%; height:100dvh; max-width:none; max-height:none; overflow:hidden; }
