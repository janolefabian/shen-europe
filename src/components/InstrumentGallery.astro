---
import type { InstrumentImage } from "../lib/instrumentImages";
import InstrumentPhoto from "./InstrumentPhoto.astro";

interface Props {
  images?: InstrumentImage[];
}

const { images = [] } = Astro.props;
---

{
  images.length > 0 && (
    <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
      {images.map((image) => (
        <figure class="overflow-hidden">
          <div class="aspect-[2/3] overflow-hidden bg-neutral-100">
            <InstrumentPhoto image={image} fit="contain" sizes="(min-width: 1024px) 360px, 45vw" />
          </div>
        </figure>
      ))}
    </div>
  )
}
