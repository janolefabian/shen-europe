---
import type { InstrumentImage } from "../lib/instrumentImages";

interface Props {
  images?: InstrumentImage[];
}

const { images = [] } = Astro.props;
---

{
  images.length > 0 && (
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {images.map((image, index) => (
        <figure
          class:list={[
            "overflow-hidden",
            index % 5 === 0 && images.length > 2 ? "sm:col-span-2" : "",
          ]}
        >
          <div class="overflow-hidden bg-neutral-100">
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              class="h-auto w-full transition duration-500 hover:scale-[1.01]"
            />
          </div>
        </figure>
      ))}
    </div>
  )
}
