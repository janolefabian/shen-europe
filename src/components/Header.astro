---
import Container from "./layout/Container.astro";

const currentPath = Astro.url.pathname;

const navigation = [
  { href: "/models", label: "Models" },
  { href: "/available", label: "Available" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<header
  data-header
  class="sticky top-0 z-50 h-[88px] border-b border-neutral-200 bg-white/90 backdrop-blur-sm transition-all duration-300 ease-out sm:h-[108px]"
>
  <Container class="flex h-full items-center justify-between">
    <a
      href="/"
      class="logo font-serif text-[1.35rem] leading-none tracking-[-0.035em] text-neutral-950 transition-all duration-300 ease-out sm:text-[2rem]"
    >
      Shen Europe
    </a>

    <nav aria-label="Main navigation">
      <ul class="flex items-center gap-3 sm:gap-8 lg:gap-10">
        {
          navigation.map((item) => {
            const isActive =
              currentPath === item.href ||
              currentPath.startsWith(`${item.href}/`);

            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive ? "page" : undefined}
                  class:list={[
                    "border-b pb-1 text-[0.78rem] transition-opacity hover:opacity-55 sm:text-[1.05rem]",
                    isActive
                      ? "border-neutral-950 text-neutral-950"
                      : "border-transparent text-neutral-700",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </Container>
</header>

<script>
  const header = document.querySelector("[data-header]");

  const setHeaderState = () => {
    if (!header) return;

    const scrolled = window.scrollY > 12;
    header.dataset.scrolled = String(scrolled);
  };

  setHeaderState();
  window.addEventListener("scroll", setHeaderState, { passive: true });
</script>
