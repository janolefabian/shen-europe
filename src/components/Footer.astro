---
import Container from "./layout/Container.astro";
import Grid from "./layout/Grid.astro";
import Stack from "./layout/Stack.astro";
import Heading from "./ui/Heading.astro";
import Text from "./ui/Text.astro";
---

<footer class="border-t border-neutral-200 bg-white">
  <Container class="py-10">
    <Grid columns={2} gap="lg">
      <Stack gap="sm">
        <Heading as="h2" size="sm"> Shen Europe </Heading>

        <Text size="sm" tone="muted" class="max-w-md">
          Samuel Shen double basses selected in Suzhou and set up in Berlin.
        </Text>
      </Stack>

      <Stack gap="xs" class="md:items-end md:text-right">
        <Text size="sm" class="text-neutral-700">
          Operated by Tempera Strings GmbH, Berlin
        </Text>

        <Text size="sm" tone="muted">
          © {new Date().getFullYear()} Shen Europe
        </Text>
      </Stack>
    </Grid>
  </Container>
</footer>
