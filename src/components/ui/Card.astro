---
interface Props {
  as?: "article" | "div" | "li";
  href?: string;
  class?: string;
  padding?: "none" | "sm" | "md" | "lg";
  bordered?: boolean;
}

const {
  as: Tag = "article",
  href,
  class: className = "",
  padding = "md",
  bordered = true,
} = Astro.props;

const paddings = {
  none: "",
  sm: "p-4",
  md: "p-6",
  lg: "p-8 lg:p-10",
};

const classes = [
  "group bg-white",
  bordered && "border border-neutral-200",
  paddings[padding],
  href && "transition hover:border-neutral-400",
  className,
];
---

{
  href ? (
    <a href={href} class:list={["block", ...classes]}>
      <slot />
    </a>
  ) : (
    <Tag class:list={classes}>
      <slot />
    </Tag>
  )
}
