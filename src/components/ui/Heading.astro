---
interface Props {
  as?: "h1" | "h2" | "h3" | "h4";
  size?: "hero" | "xl" | "lg" | "md" | "sm";
  class?: string;
}

const {
  as: Tag = "h2",
  size = "lg",
  class: className = "",
} = Astro.props;

const sizes = {
  hero: "text-[clamp(2.75rem,4.2vw,3.75rem)] leading-[1.1] tracking-[-0.025em]",
  xl: "page-title",
  lg: "section-title",
  md: "subsection-title",
  sm: "text-2xl leading-tight tracking-[-0.02em]",
};
---

<Tag class:list={["font-serif font-normal text-neutral-950", sizes[size], className]}>
  <slot />
</Tag>
