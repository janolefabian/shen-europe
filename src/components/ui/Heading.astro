---
interface Props {
  as?: "h1" | "h2" | "h3" | "h4";
  size?: "hero" | "xl" | "lg" | "md" | "sm";
  class?: string;
}

const {
  as: Tag = "h2",
  size = "lg",
  class: className = "",
} = Astro.props;

const sizes = {
  hero: "text-[clamp(3.4rem,8vw,7.6rem)] leading-[0.96] tracking-[-0.045em] lg:text-[clamp(5rem,7vw,7rem)]",
  xl: "text-5xl leading-[0.98] tracking-[-0.04em] sm:text-6xl lg:text-7xl",
  lg: "text-4xl leading-[1.02] tracking-[-0.035em] sm:text-5xl lg:text-6xl",
  md: "text-3xl leading-tight tracking-[-0.025em] sm:text-4xl",
  sm: "text-2xl leading-tight tracking-[-0.02em]",
};
---

<Tag class:list={["font-serif font-normal text-neutral-950", sizes[size], className]}>
  <slot />
</Tag>
