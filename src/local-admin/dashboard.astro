---
import { getCollection } from "astro:content";
import { getPublicationMissingFields } from "../lib/instruments";

export const prerender = false;

const instruments = (await getCollection("instruments")).sort((a, b) => {
  if (a.data.publication !== b.data.publication) {
    return a.data.publication === "draft" ? -1 : 1;
  }

  return a.data.title.localeCompare(b.data.title, "de", {
    numeric: true,
    sensitivity: "base",
  });
});

const drafts = instruments.filter(
  (instrument) => instrument.data.publication === "draft",
).length;
const incompletePublished = instruments.filter(
  (instrument) =>
    instrument.data.publication === "published" &&
    getPublicationMissingFields(instrument).length > 0,
).length;
const published = instruments.length - drafts - incompletePublished;

const fieldLabels = {
  slug: "Public-Slug",
  inventory: "interne ID",
  model: "Qualitätsstufe",
  outline: "Modell",
  shortDescription: "Kurzbeschreibung",
} as const;

const folderName = (source: string) =>
  source
    .replace(/\\/g, "/")
    .replace(/\/index(?:\.(?:md|mdx))?$/, "")
    .split("/")
    .pop() ?? source;

const availabilityLabels = {
  available: "Verfügbar",
  reserved: "Reserviert",
  "coming-soon": "Demnächst",
  sold: "Verkauft",
} as const;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | Shen Europe</title>
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        color: #171717;
        background: #f5f5f3;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-width: 320px;
      }

      a {
        color: inherit;
      }

      .shell {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
        padding: 28px 0 80px;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 56px;
      }

      .brand {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 22px;
      }

      .quiet-link {
        color: #525252;
        font-size: 14px;
        text-decoration: none;
      }

      .quiet-link:hover {
        color: #171717;
      }

      .eyebrow {
        margin: 0 0 16px;
        color: #6a6a6a;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3 {
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
      }

      h1 {
        max-width: 820px;
        margin: 0;
        font-size: clamp(46px, 7vw, 78px);
        line-height: 0.98;
        letter-spacing: -0.045em;
      }

      .intro {
        max-width: 680px;
        margin: 24px 0 0;
        color: #5f5f5f;
        font-size: 18px;
        line-height: 1.65;
      }

      .actions {
        display: grid;
        gap: 18px;
        margin-top: 52px;
      }

      .action-card {
        display: grid;
        min-height: 260px;
        align-content: space-between;
        border: 1px solid #d8d8d3;
        padding: clamp(24px, 4vw, 40px);
        text-decoration: none;
        transition:
          background-color 150ms ease,
          color 150ms ease,
          transform 150ms ease;
      }

      .action-card:hover {
        transform: translateY(-2px);
      }

      .action-card.primary {
        color: #fff;
        background: #171717;
      }

      .action-card.secondary {
        background: #fff;
      }

      .action-number {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.1em;
      }

      .action-card.primary .action-number,
      .action-card.primary .action-copy {
        color: #b9b9b9;
      }

      .action-title {
        margin: 48px 0 0;
        font-size: clamp(32px, 4vw, 46px);
        line-height: 1;
        letter-spacing: -0.035em;
      }

      .action-footer {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 24px;
        margin-top: 22px;
      }

      .action-copy {
        max-width: 430px;
        margin: 0;
        color: #646464;
        font-size: 14px;
        line-height: 1.55;
      }

      .arrow {
        font-size: 24px;
      }

      .summary {
        display: grid;
        margin-top: 64px;
        border-block: 1px solid #d8d8d3;
      }

      .stat {
        padding: 24px 0;
      }

      .stat + .stat {
        border-top: 1px solid #d8d8d3;
      }

      .stat-value {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 42px;
      }

      .stat-label {
        margin: 6px 0 0;
        color: #6a6a6a;
        font-size: 13px;
      }

      .inventory-section {
        margin-top: 72px;
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 22px;
      }

      .section-head h2 {
        margin: 0;
        font-size: clamp(34px, 5vw, 52px);
        letter-spacing: -0.035em;
      }

      .instrument-list {
        border-top: 1px solid #bfbfba;
      }

      .instrument-row {
        display: grid;
        gap: 16px;
        border-bottom: 1px solid #d8d8d3;
        padding: 22px 0;
        text-decoration: none;
      }

      .instrument-row:hover .instrument-title {
        opacity: 0.55;
      }

      .instrument-title {
        margin: 0;
        font-size: 25px;
        line-height: 1.1;
        transition: opacity 150ms ease;
      }

      .instrument-meta {
        margin: 7px 0 0;
        color: #6a6a6a;
        font-size: 13px;
      }

      .row-details {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 18px;
        color: #555;
        font-size: 13px;
      }

      .badge {
        display: inline-flex;
        min-height: 28px;
        align-items: center;
        border: 1px solid #cfcfca;
        border-radius: 999px;
        padding: 0 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .badge.draft {
        border-color: #d4b36a;
        color: #76580d;
        background: #fff8e6;
      }

      .badge.incomplete {
        border-color: #d8a6a0;
        color: #8a2d23;
        background: #fff5f3;
      }

      .empty-state {
        border-top: 1px solid #bfbfba;
        padding: 28px 0;
        color: #666;
      }

      @media (min-width: 760px) {
        .actions,
        .summary {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .stat {
          padding: 28px 30px;
        }

        .stat:first-child {
          padding-left: 0;
        }

        .stat + .stat {
          border-top: 0;
          border-left: 1px solid #d8d8d3;
        }

        .instrument-row {
          grid-template-columns: minmax(0, 1fr) auto;
          align-items: center;
        }

        .row-details {
          justify-content: flex-end;
        }
      }

      @media (max-width: 640px) {
        .shell {
          width: min(100% - 24px, 1180px);
          padding-top: 20px;
        }

        .topbar {
          margin-bottom: 42px;
        }

        .section-head {
          align-items: start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <nav class="topbar" aria-label="Admin navigation">
        <span class="brand">Shen Europe Admin</span>
        <a class="quiet-link" href="/" target="_blank">Website ansehen ↗</a>
      </nav>

      <p class="eyebrow">Instrumentenverwaltung</p>
      <h1>Ein Einstieg für den gesamten Ablauf</h1>
      <p class="intro">
        Lege einen neuen Bass zuerst aus seinen Fotos an oder öffne einen
        bestehenden Eintrag, um Daten zu ergänzen und ihn zu veröffentlichen.
      </p>

      <section class="actions" aria-label="Admin actions">
        <a class="action-card primary" href="/admin/instruments/new">
          <p class="action-number">01 · Schnellerfassung</p>
          <div>
            <h2 class="action-title">Neues Instrument aus Fotos</h2>
            <div class="action-footer">
              <p class="action-copy">
                Einen ganzen Bildsatz auswählen, Kategorien prüfen und sofort
                als unsichtbaren Entwurf anlegen.
              </p>
              <span class="arrow" aria-hidden="true">→</span>
            </div>
          </div>
        </a>

        <a
          class="action-card secondary"
          href="/keystatic/collection/instruments"
        >
          <p class="action-number">02 · Vollständiger Editor</p>
          <div>
            <h2 class="action-title">Instrumente verwalten</h2>
            <div class="action-footer">
              <p class="action-copy">
                Angaben und Texte ergänzen, Fotos ändern, Verfügbarkeit pflegen
                und fertige Einträge veröffentlichen.
              </p>
              <span class="arrow" aria-hidden="true">→</span>
            </div>
          </div>
        </a>
      </section>

      <section class="summary" aria-label="Instrument summary">
        <div class="stat">
          <p class="stat-value">{drafts}</p>
          <p class="stat-label">Entwürfe – nicht öffentlich sichtbar</p>
        </div>
        <div class="stat">
          <p class="stat-value">{published}</p>
          <p class="stat-label">Öffentlich veröffentlichte Instrumente</p>
        </div>
        {
          incompletePublished > 0 && (
            <div class="stat">
              <p class="stat-value">{incompletePublished}</p>
              <p class="stat-label">
                Unvollständig – trotz Freigabe öffentlich ausgeblendet
              </p>
            </div>
          )
        }
      </section>

      <section class="inventory-section">
        <div class="section-head">
          <div>
            <p class="eyebrow">Direktzugriff</p>
            <h2>Alle Instrumente</h2>
          </div>
          <a class="quiet-link" href="/keystatic/collection/instruments">
            Vollständige Tabellenansicht →
          </a>
        </div>

        {
          instruments.length > 0 ? (
            <div class="instrument-list">
              {instruments.map((instrument) => {
                const folder = folderName(
                  instrument.filePath ?? instrument.id,
                );
                const model = [instrument.data.model, instrument.data.outline]
                  .filter(Boolean)
                  .join(" · ");
                const missingFields = getPublicationMissingFields(instrument);
                const isIncompletePublished =
                  instrument.data.publication === "published" &&
                  missingFields.length > 0;

                return (
                  <a
                    class="instrument-row"
                    href={`/keystatic/collection/instruments/item/${encodeURIComponent(folder)}`}
                  >
                    <div>
                      <h3 class="instrument-title">{instrument.data.title}</h3>
                      <p class="instrument-meta">
                        {model || "Instrumentdaten noch offen"}
                        {isIncompletePublished && (
                          <>
                            {" · Fehlt: "}
                            {missingFields
                              .map((field) => fieldLabels[field])
                              .join(", ")}
                          </>
                        )}
                      </p>
                    </div>

                    <div class="row-details">
                      <span
                        class:list={[
                          "badge",
                          instrument.data.publication === "draft" && "draft",
                          isIncompletePublished && "incomplete",
                        ]}
                      >
                        {isIncompletePublished
                          ? "Unvollständig"
                          : instrument.data.publication === "draft"
                            ? "Entwurf"
                            : "Öffentlich"}
                      </span>
                      <span>
                        {instrument.data.gallery.length} Fotos
                      </span>
                      <span>{availabilityLabels[instrument.data.status]}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          ) : (
            <p class="empty-state">
              Noch keine Instrumente angelegt. Starte mit der Schnellerfassung.
            </p>
          )
        }
      </section>
    </main>
  </body>
</html>
