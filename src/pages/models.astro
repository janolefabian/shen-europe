---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Stack from "../components/layout/Stack.astro";
import Heading from "../components/ui/Heading.astro";
import Text from "../components/ui/Text.astro";
---

<BaseLayout
  title="Shen Double Bass Models | Shen Europe"
  description="Explore selected Samuel Shen double bass models available in Europe."
>
  <Section spacing="lg">
    <Stack gap="md" class="max-w-4xl">
      <Heading as="h1" size="xl">Models</Heading>

      <Text size="lg" class="max-w-2xl">
        Explore selected Shen models, construction levels and outlines. Other
        models can be ordered through Shen Europe.
      </Text>
    </Stack>
  </Section>
</BaseLayout>
