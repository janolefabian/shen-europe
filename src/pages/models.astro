---
import type { CollectionEntry } from "astro:content";

import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getInstruments } from "../lib/instruments";
import { bassModelGroups } from "../lib/instrumentTaxonomy";
import { withBasePath } from "../lib/sitePaths";

type Instrument = CollectionEntry<"instruments">;
type CatalogOption = (typeof bassModelGroups)[number]["options"][number];

const instruments = await getInstruments();
const currentInstruments = instruments
  .filter((instrument) => instrument.data.status !== "sold")
  .sort((a, b) =>
    a.data.model.localeCompare(b.data.model, "en", { numeric: true }),
  );

const catalogSections = [
  {
    number: "01",
    title: "Fully carved",
    codes: "SB-200, SB-300, SB-800, SB-1000",
    description:
      "Carved solid wood throughout. This group includes maple and willow models in several outlines.",
    groupLabels: [
      "Vollmassiv – Ahorn",
      "Vollmassiv – Weide",
    ],
  },
  {
    number: "02",
    title: "Hybrid",
    codes: "SB-150, SB-180",
    description:
      "A carved spruce top with laminated back and ribs.",
    groupLabels: ["Hybrid"],
  },
  {
    number: "03",
    title: "Laminated",
    codes: "SB-80, SB-88, SB-90, SB-100",
    description:
      "Laminated top, back and ribs for regular transport and daily use.",
    groupLabels: ["Laminat"],
  },
] as const;

const publicGroupLabels: Record<string, string> = {
  "Vollmassiv – Ahorn": "Maple",
  "Vollmassiv – Weide": "Willow",
  Hybrid: "Hybrid models",
  Laminat: "Laminated models",
};

const statusLabels = {
  available: "Available",
  reserved: "Reserved",
  "coming-soon": "Coming soon",
  sold: "Sold",
} as const;

const statusDots = {
  available: "bg-emerald-600",
  reserved: "bg-amber-500",
  "coming-soon": "bg-sky-600",
  sold: "bg-neutral-400",
} as const;

const getAvailableForOption = (option: CatalogOption): Instrument[] => {
  const qualities = option.qualities as readonly string[];

  return currentInstruments.filter(
    (instrument) =>
      qualities.includes(instrument.data.model) &&
      instrument.data.outline === option.value,
  );
};

---

<BaseLayout
  title="Samuel Shen Double Bass Models | Shen Europe"
  description="An overview of Samuel Shen double basses by construction, model series, outline and tonewood."
>
  <section class="py-20 sm:py-24 lg:py-32">
    <div class="mx-auto w-full max-w-[1600px] px-5 sm:px-8 lg:px-12">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(320px,0.8fr)] lg:items-end lg:gap-24">
        <div class="max-w-5xl">
          <p class="text-sm tracking-[0.1em] text-neutral-500 uppercase">
            Samuel Shen double basses
          </p>
          <h1 class="mt-6 font-serif text-5xl leading-[0.96] tracking-[-0.045em] text-neutral-950 sm:text-6xl lg:text-7xl xl:text-[5.25rem]">
            The Shen range by construction and model
          </h1>
        </div>

        <div class="max-w-xl">
          <p class="text-lg leading-relaxed text-neutral-600">
            A Shen model number identifies the construction and specification
            level. The outline, size and choice of wood describe the instrument
            further.
          </p>
          <a
            href="#complete-range"
            class="mt-7 inline-block border-b border-neutral-950 pb-1 text-sm font-medium text-neutral-950 transition-opacity hover:opacity-55"
          >
            View the complete range
          </a>
        </div>
      </div>

      <div class="mt-16 grid border-y border-neutral-200 md:grid-cols-3 lg:mt-20">
        {
          catalogSections.map((section, index) => (
            <article
              class:list={[
                "py-8 md:px-8 lg:p-10",
                index > 0 && "border-t border-neutral-200 md:border-t-0 md:border-l",
              ]}
            >
              <div class="flex items-center justify-between gap-5">
                <p class="text-xs tracking-[0.1em] text-neutral-400">
                  {section.number}
                </p>
                <p class="text-xs tracking-[0.08em] text-neutral-500 uppercase">
                  {section.codes}
                </p>
              </div>
              <h2 class="mt-8 font-serif text-3xl tracking-[-0.025em] text-neutral-950 lg:text-4xl">
                {section.title}
              </h2>
              <p class="mt-4 max-w-md text-sm leading-relaxed text-neutral-600">
                {section.description}
              </p>
            </article>
          ))
        }
      </div>

      <div class="mt-12 grid gap-6 border-t border-neutral-200 pt-10 lg:grid-cols-[minmax(240px,0.55fr)_minmax(0,1.45fr)] lg:gap-20">
        <h2 class="font-serif text-3xl tracking-[-0.025em] text-neutral-950">
          What the model levels describe
        </h2>
        <div class="max-w-3xl space-y-4 text-base leading-relaxed text-neutral-600">
          <p>
            Shen model levels describe the materials, components and work
            invested in an instrument. Higher levels involve a more selective
            choice of woods, additional handwork, more detailed plate
            graduation and higher-grade components. The precise combination
            varies between models.
          </p>
          <p>
            The price difference reflects the materials, components and work
            invested in each instrument.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="complete-range" class="scroll-mt-24 border-t border-neutral-200 bg-neutral-50 py-20 sm:py-24 lg:py-32">
    <div class="mx-auto w-full max-w-[1600px] px-5 sm:px-8 lg:px-12">
      <div class="grid gap-8 lg:grid-cols-[minmax(240px,0.55fr)_minmax(0,1.45fr)] lg:gap-20">
        <div>
          <p class="text-sm tracking-[0.1em] text-neutral-500 uppercase">
            Complete range
          </p>
        </div>
        <div class="max-w-4xl">
          <h2 class="font-serif text-4xl leading-[1.05] tracking-[-0.035em] text-neutral-950 sm:text-5xl lg:text-6xl">
            Construction levels and available outlines
          </h2>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-neutral-600">
            Some model series are available in several body patterns. The list
            below shows the available combinations and whether an example is
            currently in Europe.
          </p>
        </div>
      </div>

      <div class="mt-16 border-t border-neutral-300">
        {
          catalogSections.map((section) => {
            const groups = bassModelGroups.filter((group) =>
              section.groupLabels.some((label) => label === group.label),
            );

            return (
              <article class="grid gap-10 border-b border-neutral-300 py-12 lg:grid-cols-[minmax(220px,0.55fr)_minmax(0,1.45fr)] lg:gap-20 lg:py-16">
                <div>
                  <p class="text-xs tracking-[0.1em] text-neutral-400">
                    {section.number}
                  </p>
                  <h3 class="mt-4 font-serif text-4xl tracking-[-0.035em] text-neutral-950 sm:text-5xl">
                    {section.title}
                  </h3>
                  <p class="mt-4 max-w-sm text-sm leading-relaxed text-neutral-600">
                    {section.description}
                  </p>
                </div>

                <div class="space-y-10">
                  {groups.map((group) => (
                    <section>
                      <div class="flex items-center gap-4">
                        <h4 class="text-xs font-medium tracking-[0.1em] text-neutral-500 uppercase">
                          {publicGroupLabels[group.label] ?? group.label}
                        </h4>
                        <span class="h-px flex-1 bg-neutral-200" aria-hidden="true" />
                      </div>

                      <div class="mt-4 border-y border-neutral-200 bg-white">
                        {group.options.map((option, optionIndex) => {
                          const matchingInstruments =
                            getAvailableForOption(option);
                          const firstInstrument = matchingInstruments[0];

                          return (
                              <div
                                class:list={[
                                  "grid gap-4 px-5 py-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:px-6",
                                  optionIndex > 0 &&
                                    "border-t border-neutral-200",
                                ]}
                              >
                                <div>
                                  <h5 class="text-base font-medium text-neutral-950">
                                    {option.label}
                                  </h5>
                                  <div class="mt-3 flex flex-wrap gap-2">
                                    {option.qualities.map((quality) => (
                                      <span class="rounded-full border border-neutral-200 px-2.5 py-1 text-xs text-neutral-600">
                                        {quality}
                                      </span>
                                    ))}
                                  </div>
                                </div>

                                {firstInstrument ? (
                                  <a
                                    href={withBasePath(`/instruments/${firstInstrument.data.slug}/`)}
                                    class="inline-flex items-center gap-2 text-sm font-medium text-neutral-950 transition-opacity hover:opacity-55"
                                  >
                                    {matchingInstruments.length === 1
                                      ? "1 instrument available"
                                      : `${matchingInstruments.length} instruments available`}
                                    <span aria-hidden="true">→</span>
                                  </a>
                                ) : (
                                  <span class="text-sm text-neutral-500">
                                    Available by special order
                                  </span>
                                )}
                              </div>
                          );
                        })}
                      </div>
                    </section>
                  ))}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="border-t border-neutral-200 py-20 sm:py-24 lg:py-28">
    <div class="mx-auto grid w-full max-w-[1600px] gap-12 px-5 sm:px-8 lg:grid-cols-[minmax(260px,0.55fr)_minmax(0,1.45fr)] lg:gap-20 lg:px-12">
      <div>
        <p class="text-sm tracking-[0.1em] text-neutral-500 uppercase">
          Individual instruments
        </p>
        <h2 class="mt-4 font-serif text-4xl leading-[1.05] tracking-[-0.03em] text-neutral-950 sm:text-5xl">
          Currently in Europe
        </h2>
      </div>

      <div>
        <p class="max-w-3xl text-lg leading-relaxed text-neutral-600">
          The model describes the specification. The instrument pages document
          the voice, response, wood and setup of each bass in Europe.
        </p>

        {
          currentInstruments.length > 0 ? (
            <div class="mt-9 border-t border-neutral-300">
              {currentInstruments.map((instrument) => (
                <article class="grid gap-5 border-b border-neutral-200 py-6 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center sm:gap-8">
                  <div>
                    <h3 class="font-serif text-2xl tracking-[-0.02em] text-neutral-950">
                      {instrument.data.title}
                    </h3>
                    <p class="mt-1 text-sm text-neutral-500">
                      {instrument.data.size ?? "Size on request"}
                      {instrument.data.stringLength && ` · ${instrument.data.stringLength}`}
                    </p>
                  </div>

                  <span class="inline-flex w-fit items-center gap-2 text-sm text-neutral-600">
                    <span
                      class:list={[
                        "size-1.5 rounded-full",
                        statusDots[instrument.data.status],
                      ]}
                      aria-hidden="true"
                    />
                    {statusLabels[instrument.data.status]}
                  </span>

                  <a
                    href={withBasePath(`/instruments/${instrument.data.slug}/`)}
                    class="inline-flex items-center gap-2 text-sm font-medium text-neutral-950 transition-opacity hover:opacity-55"
                  >
                    View instrument <span aria-hidden="true">→</span>
                  </a>
                </article>
              ))}
            </div>
          ) : (
            <p class="mt-9 border-t border-neutral-200 pt-6 text-neutral-600">
              The next European instruments are currently being prepared.
            </p>
          )
        }

        <Button href="/available" variant="text" class="mt-8">
          View all available instruments
        </Button>
      </div>
    </div>
  </section>

  <section class="border-t border-neutral-200 bg-neutral-950 py-20 text-white sm:py-24 lg:py-28">
    <div class="mx-auto grid w-full max-w-[1600px] gap-10 px-5 sm:px-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-20 lg:px-12">
      <div class="max-w-4xl">
        <p class="text-sm tracking-[0.1em] text-neutral-400 uppercase">
          Selection and special orders
        </p>
        <h2 class="mt-4 font-serif text-4xl leading-[1.05] tracking-[-0.035em] sm:text-5xl lg:text-6xl">
          Not sure which model fits?
        </h2>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-neutral-300">
          Tell us how you will use the instrument, which dimensions work for
          you and what kind of response you prefer. We can then narrow down the
          construction, outline and setup.
        </p>
      </div>

      <Button
        href="/contact"
        variant="outline"
        size="lg"
        class="border-white text-white hover:bg-white hover:text-neutral-950"
      >
        Discuss the right instrument
      </Button>
    </div>
  </section>
</BaseLayout>
