---
import Container from "../components/layout/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ModelEntry from "../components/ModelEntry.astro";
import { getInstruments } from "../lib/instruments";
import { bassModelGroups } from "../lib/instrumentTaxonomy";
import { modelDisplayPriority, modelPresentation } from "../lib/modelPresentation";
import { withBasePath } from "../lib/sitePaths";

const instruments = await getInstruments();
const sections = [
  { id: "fully-carved", title: "Fully carved",
    description: "Carved spruce tops and carved maple or willow backs. Rib construction is noted where it differs.",
    groups: ["Vollmassiv – Ahorn", "Vollmassiv – Weide"] },
  { id: "hybrid", title: "Hybrid",
    description: "A carved spruce top, with a laminated back and ribs.",
    groups: ["Hybrid"] },
  { id: "laminated", title: "Laminated",
    description: "Laminated top, back and ribs.",
    groups: ["Laminat"] },
];
const labels: Record<string, string> = {
  "Vollmassiv – Ahorn": "Maple", "Vollmassiv – Weide": "Willow",
  Hybrid: "Hybrid models", Laminat: "Laminated models",
};
---

<BaseLayout title="Models and body patterns | Shen Europe"
  description="Explore Samuel Shen double bass body patterns with simple outline drawings, construction types and model levels. See individual instruments available to try.">
  <section class="models-intro">
    <Container>
      <h1 class="page-title">Models</h1>
      <p class="intro-copy">Samuel Shen body patterns and model levels, grouped by construction.</p>
      <div class="guide-tools">
        <nav class="range-nav" aria-label="Model construction types">
          {sections.map((section) => <a href={`#${section.id}`}>{section.title}<span aria-hidden="true">↓</span></a>)}
        </nav>
        <details class="name-guide">
          <summary>Model names and SB numbers</summary>
          <div class="expanded-copy">
            <dl class="name-example">
              <div><dt>Model level</dt><dd>SB-800</dd></div>
              <div><dt>Body pattern</dt><dd>Shen Classic</dd></div>
              <div><dt>Size</dt><dd>3/4</dd></div>
            </dl>
            <p>The SB number identifies a construction and specification level. Wood selection,
              components and the work involved matter; their exact combination depends on the model and instrument.</p>
            <p>In the US Rogeri maple description, SB-200, SB-300 and SB-800 distinguish progressively
              stronger maple figuring. That is one catalogue distinction, not a complete specification or a sound ranking.</p>
            <a href="https://cscproducts.com/products/bass-rogeri-maple.html" class="quiet-link">US Rogeri model reference</a>
          </div>
        </details>
      </div>
      <p class="drawing-note">The drawings compare body shapes at equal height, not actual instrument sizes.</p>
    </Container>
  </section>

  <div id="complete-range">
    {sections.map((section) => (
      <section id={section.id} class="range-section" aria-labelledby={`${section.id}-title`}>
        <Container>
          <header class="range-heading">
            <h2 id={`${section.id}-title`} class="section-title">{section.title}</h2>
            <p>{section.description}</p>
          </header>
          {bassModelGroups.filter((group) => section.groups.includes(group.label)).map((group) => (
            <div class="material-group">
              <h3 class:list={["material-title", section.groups.length === 1 && "sr-only"]}>{labels[group.label]}</h3>
              <div class:list={["model-grid", group.options.length === 4 && "balanced-grid"]}>
                {[...group.options].sort((a, b) => modelDisplayPriority(a.value) - modelDisplayPriority(b.value))
                  .map((option) => <ModelEntry option={option} instruments={instruments} />)}
              </div>
            </div>
          ))}
        </Container>
      </section>
    ))}
  </div>

  <section class="guide-notes">
    <Container class="grid gap-8 md:grid-cols-2 lg:gap-20">
      <div>
        <h2 class="subsection-title">From a model to an individual bass</h2>
        <p>The model guide describes the range, not stock availability.
          The photographs and playing notes on each instrument page refer to that particular bass.</p>
        <a href={withBasePath("/available")} class="quiet-link">View available instruments</a>
      </div>
      <details class="sources">
        <summary>About the drawings and model references</summary>
        <div class="expanded-copy">
          <p>These are smoothed, symmetrised body outlines based on front photographs,
            not measured plans. Related models may share a body pattern; a drawing does not
            describe every size or variant. Necks, scrolls, rib depth and back shape are not shown.</p>
          <p>The guide follows the US catalogue, with the SB-1000 Panormo already received
            by Shen Europe. Its outline is drawn from our own photograph.
            Specifications and supply for another instrument are confirmed individually.</p>
          <a href="https://cscproducts.com/products.html" class="quiet-link">US model catalogue</a>
          <ul class="reference-links">
            {bassModelGroups.flatMap((group) => group.options).map((option) => {
              const source = modelPresentation[option.value].source;
              return <li><a href={source.startsWith("/") ? withBasePath(source) : source}>{option.label}</a></li>;
            })}
          </ul>
        </div>
      </details>
    </Container>
  </section>
</BaseLayout>

<style>
  .models-intro { padding-block: 2rem 1rem; }
  .intro-copy { margin-top: 1rem; max-width: 42rem; font-size: 1rem; line-height: 1.8; color: #666; }
  .guide-tools { display: grid; gap: 1rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #ddd; align-items: baseline; }
  .name-guide { font-size: .8125rem; color: #666; }
  .name-example { display: grid; grid-template-columns: auto auto auto; justify-content: start; gap: 1.25rem; margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #ddd; }
  .name-example div { display: flex; flex-direction: column-reverse; gap: .5rem; }
  .name-example dd { font-family: var(--font-serif); font-size: 1.125rem; line-height: 1.3; color: #222; }
  .name-example dt { font-size: .6875rem; color: #777; }
  summary { cursor: pointer; width: fit-content; }
  .expanded-copy { margin-top: 1rem; color: #666; font-size: .875rem; line-height: 1.8; }
  .expanded-copy p + p { margin-top: .85rem; }
  .expanded-copy .quiet-link { margin-top: .8rem; }
  .range-nav { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; font-size: .8125rem; }
  .range-nav a { display: inline-flex; align-items: center; gap: .9rem; padding-block: .25rem; text-underline-offset: .3em; }
  .range-nav span { color: #888; }
  .range-nav a:hover { text-decoration: underline; }
  .drawing-note { margin-top: 1rem; color: #777; font-size: .75rem; line-height: 1.65; }
  .range-section { padding-block: 2.25rem 1.75rem; scroll-margin-top: 100px; }
  .range-section + .range-section { border-top: 1px solid #ddd; }
  .range-section:nth-child(2) { background: #f8f8f6; }
  .range-heading { display: grid; gap: .75rem; margin-bottom: 1.25rem; }
  .range-heading p { max-width: 34rem; font-size: .875rem; line-height: 1.7; color: #666; }
  .material-group + .material-group { margin-top: 1rem; }
  .material-title { font-size: .6875rem; letter-spacing: .1em; text-transform: uppercase; color: #777; margin-bottom: .75rem; }
  .model-grid { display: grid; column-gap: 2.5rem; }
  .guide-notes { border-top: 1px solid #ddd; padding-block: 2.75rem; }
  .guide-notes p { margin-top: 1rem; color: #666; font-size: .875rem; line-height: 1.8; }
  .guide-notes .quiet-link { margin-top: 1rem; }
  .sources summary { font-family: var(--font-serif); font-size: 1.25rem; line-height: 1.4; }
  .reference-links { margin-top: 1rem; display: grid; gap: .4rem 1.5rem; font-size: .75rem; }
  .reference-links a { text-decoration: underline; text-underline-offset: .2em; }
  a:focus-visible, summary:focus-visible { outline: 2px solid #171717; outline-offset: 5px; }
  @media (max-width: 639px) {
    .range-section { padding-top: 1.5rem; }
  }
  @media (min-width: 640px) {
    .models-intro { padding-top: 2.5rem; }
    .range-heading { grid-template-columns: 1fr 1.5fr; align-items: baseline; gap: 2rem; }
    .model-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .range-section { padding-block: 2rem; }
    .reference-links { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 768px) {
    .guide-tools { grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; }
    .name-guide { max-width: 28rem; }
    .name-guide summary { margin-left: auto; }
  }
  @media (min-width: 1200px) {
    .model-grid:not(.balanced-grid) { grid-template-columns: repeat(3, minmax(0,1fr)); }
    .model-grid { column-gap: 3rem; }
  }
</style>
