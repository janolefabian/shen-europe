---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Available Shen Double Basses | Shen Europe"
  description="Samuel Shen double basses currently available for trial and purchase in Berlin."
>
  <section class="mx-auto max-w-[1600px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <h1
      class="font-serif max-w-4xl text-5xl leading-[0.98] tracking-[-0.04em] text-neutral-950 sm:text-6xl lg:text-7xl"
    >
      Available Instruments
    </h1>

    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-neutral-700">
      A small selection of personally selected instruments is available for
      trial in Berlin. Additional Shen models can be ordered.
    </p>
  </section>
</BaseLayout>
