---
import InstrumentCard from "../components/InstrumentCard.astro";
import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getInstruments } from "../lib/instruments";

const instruments = (await getInstruments())
  .filter((instrument) => instrument.data.status !== "sold")
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Available Shen Double Basses | Shen Europe"
  description="Samuel Shen double basses currently available, reserved or arriving soon in Berlin."
>
  <section class="py-20 sm:py-24 lg:py-32">
    <div class="mx-auto w-full max-w-[1600px] px-5 sm:px-8 lg:px-12">
      <div class="max-w-4xl">
        <h1 class="font-serif text-5xl leading-[0.98] tracking-[-0.04em] text-neutral-950 sm:text-6xl lg:text-7xl">
          Available Instruments
        </h1>

        <p class="mt-8 max-w-3xl text-lg leading-relaxed text-neutral-600">
          Each instrument is personally selected and professionally set up in
          Berlin. Available instruments can be tried by appointment. Other Shen
          models are available by special order.
        </p>

        <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3 border-t border-neutral-200 pt-6 text-sm text-neutral-700">
          <li class="flex items-center gap-3">
            <span class="size-1.5 rounded-full bg-neutral-950" aria-hidden="true"></span>
            Trials by appointment in Berlin
          </li>
          <li class="flex items-center gap-3">
            <span class="size-1.5 rounded-full bg-neutral-950" aria-hidden="true"></span>
            European delivery available
          </li>
        </ul>
      </div>

      {
        instruments.length > 0 ? (
          <div class="mt-16 grid gap-x-8 gap-y-20 lg:grid-cols-2">
            {instruments.map((instrument) => (
              <InstrumentCard instrument={instrument} />
            ))}
          </div>
        ) : (
          <div class="mt-16 max-w-3xl border-t border-neutral-200 pt-10">
            <p class="text-lg leading-relaxed text-neutral-700">
              No instruments are currently available for immediate trial.
              Contact Shen Europe to discuss incoming instruments or a special
              order.
            </p>
            <Button href="/contact" variant="text" class="mt-7">
              Contact Shen Europe
            </Button>
          </div>
        )
      }
    </div>
  </section>

  <section class="border-t border-neutral-200 py-16 sm:py-20 lg:py-24">
    <div class="mx-auto grid w-full max-w-[1600px] gap-8 px-5 sm:px-8 lg:grid-cols-[1fr_auto] lg:items-end lg:px-12">
      <div class="max-w-3xl">
        <p class="text-sm tracking-[0.1em] text-neutral-500 uppercase">
          Special orders
        </p>
        <h2 class="mt-4 font-serif text-4xl leading-[1.05] tracking-[-0.03em] text-neutral-950 sm:text-5xl">
          Looking for a different model?
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-600">
          Other Shen instruments can be sourced to order and professionally
          prepared in Berlin.
        </p>
      </div>

      <Button href="/contact" variant="outline" size="lg">
        Discuss a special order
      </Button>
    </div>
  </section>
</BaseLayout>
