---
import { getCollection } from "astro:content";
import InstrumentCard from "../components/InstrumentCard.astro";
import Section from "../components/layout/Section.astro";
import Stack from "../components/layout/Stack.astro";
import Heading from "../components/ui/Heading.astro";
import Text from "../components/ui/Text.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const instruments = (await getCollection("instruments", ({ data }) =>
  data.status !== "sold"
)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Available Shen Double Basses | Shen Europe"
  description="Samuel Shen double basses currently available, reserved or expected for trial and purchase in Berlin."
>
  <Section spacing="lg">
    <Stack gap="xl">
      <Stack gap="md" class="max-w-4xl">
        <Heading as="h1" size="xl">Available Instruments</Heading>

        <Text size="lg" tone="muted" class="max-w-2xl">
          A small selection of personally selected instruments is available for
          trial in Berlin. Other Shen models can be ordered through Shen Europe.
        </Text>
      </Stack>

      {instruments.length > 0 ? (
        <div class="grid gap-x-10 gap-y-20 lg:grid-cols-2 xl:gap-x-14">
          {instruments.map((instrument) => (
            <InstrumentCard instrument={instrument} />
          ))}
        </div>
      ) : (
        <div class="border-t border-neutral-200 pt-10">
          <Text size="lg">No instruments are currently listed.</Text>
          <Text tone="muted" class="mt-3">
            Please contact us to discuss a special order.
          </Text>
        </div>
      )}
    </Stack>
  </Section>
</BaseLayout>
