---
import Container from "../components/layout/Container.astro";
import InstrumentCard from "../components/InstrumentCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { groupInventory } from "../lib/instrumentAvailability";
import { getInstruments } from "../lib/instruments";
import { withBasePath } from "../lib/sitePaths";

const groups = groupInventory(await getInstruments());
const visibleGroups = groups.filter((group) => group.status === "available" || group.instruments.length > 0);
---

<BaseLayout
  title="Showroom | Shen Europe"
  description="Individual Samuel Shen double basses in Berlin, with photographs and specifications. Available, incoming, reserved and sold instruments are listed separately."
>
  <section class="py-12 sm:py-16">
    <Container>
      <h1 class="page-title text-neutral-950">Showroom</h1>
      <p class="mt-6 max-w-2xl text-base leading-[1.8] text-neutral-600">
        Try the available basses in Berlin by appointment.
        Each instrument is documented with photographs and details of its fitted components.
        Please enquire for pricing.
      </p>
      <nav aria-label="Instrument availability" class="mt-8 flex flex-wrap gap-x-7 gap-y-4 border-t border-neutral-200 pt-5">
        {visibleGroups.map((group) => (
          <a href={`#${group.id}`} class="quiet-link">
            {group.title} <span class="ml-1 text-neutral-500">({group.instruments.length})</span>
          </a>
        ))}
      </nav>
    </Container>
  </section>

  {visibleGroups.map((group) => (
    <section id={group.id} data-inventory-status={group.status}
      aria-labelledby={`${group.id}-title`}
      class:list={["scroll-mt-28 border-t border-neutral-200 py-12 sm:py-16", group.status === "sold" && "bg-neutral-50"]}
    >
      <Container>
        <div class="max-w-2xl">
          <h2 id={`${group.id}-title`} class="section-title text-neutral-950">{group.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-600">{group.description}</p>
        </div>
        {group.instruments.length > 0 ? (
          <div class:list={["mt-9 grid gap-x-7 gap-y-12 sm:grid-cols-2", group.status === "sold" ? "lg:grid-cols-4" : group.instruments.length < 3 ? "justify-items-center" : "xl:grid-cols-3"]}>
            {group.instruments.map((instrument) => (
              <InstrumentCard instrument={instrument} variant={group.status === "sold" ? "archive" : "compact"} />
            ))}
          </div>
        ) : (
          <p class="mt-8 max-w-xl text-base leading-relaxed text-neutral-600">
            No instruments are currently available to try.
            <a href={withBasePath("/contact")} class="quiet-link">Contact us about availability.</a>
          </p>
        )}
      </Container>
    </section>
  ))}

  <section class="border-t border-neutral-200 py-10">
    <Container class="flex flex-wrap items-baseline justify-between gap-5">
      <p class="max-w-xl text-sm leading-relaxed text-neutral-600">
        Looking beyond the current stock? The model overview explains the wider range.
      </p>
      <a href={withBasePath("/models")} class="quiet-link">Model overview</a>
    </Container>
  </section>
</BaseLayout>
