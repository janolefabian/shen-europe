---
import { render } from "astro:content";
import Container from "../../components/layout/Container.astro";
import InstrumentPhoto from "../../components/InstrumentPhoto.astro";
import InstrumentGallery from "../../components/InstrumentGallery.astro";
import YouTubeVideo from "../../components/YouTubeVideo.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getInstrumentImages, getInstrumentPhotoCrop } from "../../lib/instrumentImages";
import { getInstruments } from "../../lib/instruments";
import { withBasePath } from "../../lib/sitePaths";
import { instrumentStatusLabels, instrumentStatusNotes } from "../../lib/instrumentAvailability";

export async function getStaticPaths() {
  return (await getInstruments()).map((instrument) => ({
    params: { slug: instrument.data.slug }, props: { instrument },
  }));
}
const { instrument } = Astro.props;
const { data } = instrument;
const { Content } = await render(instrument);
const images = getInstrumentImages(instrument.filePath ?? instrument.id, data.title, data);
const isSold = data.status === "sold";
const inquiryUrl = withBasePath(isSold
  ? `/contact?similar=${encodeURIComponent(data.slug)}`
  : `/contact?instrument=${encodeURIComponent(data.slug)}`);
const conditionLabels = { new: "New", demonstrator: "Demonstrator", "pre-owned": "Pre-owned" };
const confirmed = [
  ["Condition", data.condition && conditionLabels[data.condition]],
  ["Year", data.year?.toString()],
  ["Tuning machines", data.tuningMachines],
  ["Strings", data.strings],
  ["Bridge", data.bridge],
].filter((item): item is [string, string] => Boolean(item[1]));
const specifications = [
  ["Model level", data.model], ["Body pattern", data.outline], ["Size", data.size],
  ["String length", data.stringLength], ["Body length", data.bodyLength], ["Weight", data.weight],
  ["Top", data.topMaterial], ["Back", data.backMaterial], ["Ribs", data.ribs],
  ["Purfling", data.purfling], ["Varnish", data.varnish], ["Neck", data.neck],
  ["Fingerboard", data.fingerboard], ["Tailpiece", data.tailpiece], ["Endpin", data.endpin],
].filter((item): item is [string, string] => Boolean(item[1]));
const gallery = [...images.gallery].sort((a, b) => {
  const priority = ["body-back", "tuning-machines-detail", "side-ribs", "side-ribs-front", "corner-detail", "body-front"];
  const rank = (category?: string) => { const i = priority.indexOf(category ?? ""); return i < 0 ? priority.length : i; };
  return rank(a.category) - rank(b.category);
});
---

<BaseLayout title={`${data.title} | Shen Europe`} description={data.shortDescription}>
  <section class="py-8 sm:py-12">
    <Container>
      <a href={withBasePath("/available")} class="quiet-link">All instruments</a>
      <div class="mt-7 grid gap-8 md:grid-cols-2 md:items-center lg:gap-20">
        <div class="order-2 mx-auto w-full max-w-[380px] md:order-1">
          {images.hero && <InstrumentPhoto image={images.hero}
            crop={getInstrumentPhotoCrop(data.inventory, images.hero)}
            loading="eager" priority sizes="(min-width: 768px) 380px, 88vw" />}
        </div>
        <div class="order-1 md:order-2">
          <p class="eyebrow">{instrumentStatusLabels[data.status]}</p>
          <h1 class="page-title mt-4">{data.title}</h1>
          <p class="mt-6 max-w-xl text-base leading-[1.8] text-neutral-600">{data.shortDescription}</p>
          <div class="mt-6 border-y border-neutral-200 py-5">
            <p class="text-sm leading-relaxed text-neutral-700">{instrumentStatusNotes[data.status]}</p>
          </div>
          <a href={inquiryUrl} class="quiet-link mt-6">
            {isSold ? "Ask about a similar instrument" : data.status === "unavailable" ? "Ask about this reference" : "Enquire about this instrument"}
          </a>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-t border-neutral-200 py-12 sm:py-16">
    <Container class="grid gap-10 md:grid-cols-2 lg:gap-20">
      <div class="instrument-copy text-base leading-[1.8] text-neutral-600"><Content /></div>
      <div>
        <h2 class="subsection-title">Documented on this instrument</h2>
        <dl class="mt-5 divide-y divide-neutral-200 border-y border-neutral-200">
          {confirmed.map(([label, value]) => (
            <div class="grid grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] gap-4 py-3 text-sm leading-relaxed">
              <dt class="text-neutral-500">{label}</dt><dd>{value}</dd>
            </div>
          ))}
        </dl>
        <h2 class="subsection-title mt-10">Model-reference specifications</h2>
        <p class="mt-3 text-sm leading-relaxed text-neutral-500">
          Standard construction and dimensions from the model description.
          These are not a new set of measurements or a specification for every future delivery.
        </p>
        <dl class="mt-5 divide-y divide-neutral-200 border-y border-neutral-200">
          {specifications.map(([label, value]) => (
            <div class="grid grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] gap-4 py-3 text-sm leading-relaxed">
              <dt class="text-neutral-500">{label}</dt><dd>{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Container>
  </section>

  {gallery.length > 0 && (
    <section id="gallery" class="scroll-mt-28 border-t border-neutral-200 py-12 sm:py-16">
      <Container>
        <h2 class="section-title mb-8">Photographs of this instrument</h2>
        <InstrumentGallery images={gallery} />
      </Container>
    </section>
  )}
  {data.youtubeVideoId && (
    <section class="border-t border-neutral-200 py-12 sm:py-16">
      <Container>
        <h2 class="section-title">Listen to this instrument</h2>
        <div class="mt-8"><YouTubeVideo videoId={data.youtubeVideoId} title={`${data.title} video`} /></div>
      </Container>
    </section>
  )}
</BaseLayout>
<style>
  .instrument-copy :global(h2) { margin-block: 2.25rem 1rem; color: #171717; font-family: var(--font-serif); font-size: clamp(1.375rem, 2vw, 1.625rem); font-weight: 400; line-height: 1.25; }
  .instrument-copy :global(h2:first-child) { margin-top: 0; }
  .instrument-copy :global(p + p) { margin-top: 1rem; }
</style>
