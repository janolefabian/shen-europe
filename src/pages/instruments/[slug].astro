---
import { render } from "astro:content";

import InstrumentGallery from "../../components/InstrumentGallery.astro";
import YouTubeVideo from "../../components/YouTubeVideo.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getInstrumentImages } from "../../lib/instrumentImages";
import { getInstruments } from "../../lib/instruments";

export async function getStaticPaths() {
  const instruments = await getInstruments();

  return instruments.map((instrument) => ({
    params: { slug: instrument.data.slug },
    props: { instrument },
  }));
}

const { instrument } = Astro.props;
const { data } = instrument;
const { Content } = await render(instrument);

const images = getInstrumentImages(
  instrument.filePath ?? instrument.id,
  data.title,
);
const inquiryUrl = `/contact?instrument=${encodeURIComponent(data.slug)}`;

const statusLabels = {
  available: "Available",
  reserved: "Reserved",
  "coming-soon": "Coming soon",
  sold: "Sold",
};

const specifications = [
  ["Inventory", data.inventory],
  ["Model", data.model],
  ["Outline", data.outline],
  ["Size", data.size],
  ["Year", data.year?.toString()],
  ["String length", data.stringLength],
  ["Body length", data.bodyLength],
  ["Weight", data.weight],
  ["Top", data.topMaterial],
  ["Back", data.backMaterial],
  ["Ribs", data.ribs],
  ["Purfling", data.purfling],
  ["Varnish", data.varnish],
  ["Neck", data.neck],
  ["Fingerboard", data.fingerboard],
  ["Tuning machines", data.tuningMachines],
  ["Endpin", data.endpin],
  ["Warranty", data.warranty],
].filter((item): item is [string, string] => Boolean(item[1]));
---

<BaseLayout
  title={`${data.title} | Shen Europe`}
  description={data.shortDescription}
>
  <section class="grid grid-cols-1 lg:grid-cols-2">
    <div
      class="min-h-[62vh] overflow-hidden bg-neutral-100 lg:min-h-[calc(100vh-108px)]"
    >
      {
        images.hero ? (
          <img
            src={images.hero.src}
            alt={images.hero.alt}
            class="h-full w-full object-cover object-center"
          />
        ) : (
          <div class="flex h-full min-h-[62vh] items-center justify-center text-neutral-400">
            Image coming soon
          </div>
        )
      }
    </div>

    <div
      class="flex items-center px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24"
    >
      <div class="max-w-2xl">
        <p class="text-sm text-neutral-500">
          {data.model} · {data.outline}
        </p>

        <h1
          class="mt-3 font-serif text-5xl leading-[0.98] font-normal tracking-[-0.04em] text-neutral-950 sm:text-6xl lg:text-7xl"
        >
          {data.title}
        </h1>

        <p class="mt-8 text-lg leading-[1.7] text-neutral-600">
          {data.shortDescription}
        </p>

        <dl
          class="mt-10 grid grid-cols-2 gap-x-8 gap-y-5 border-y border-neutral-200 py-6 text-sm"
        >
          <div>
            <dt class="text-neutral-500">Status</dt>
            <dd class="mt-1 text-neutral-950">{statusLabels[data.status]}</dd>
          </div>

          <div>
            <dt class="text-neutral-500">Location</dt>
            <dd class="mt-1 text-neutral-950">{data.location}</dd>
          </div>

          <div>
            <dt class="text-neutral-500">Pricing</dt>
            <dd class="mt-1 text-neutral-950">On request</dd>
          </div>

          {
            data.stringLength && (
              <div>
                <dt class="text-neutral-500">String length</dt>
                <dd class="mt-1 text-neutral-950">{data.stringLength}</dd>
              </div>
            )
          }
        </dl>

        <a
          href={inquiryUrl}
          class="mt-10 inline-block border-b-2 border-neutral-950 pb-2 text-sm font-semibold tracking-[0.1em] uppercase transition-opacity hover:opacity-55"
        >
          Enquire about this instrument
        </a>
      </div>
    </div>
  </section>

  {
    images.gallery.length > 0 && (
      <section class="border-t border-neutral-200 py-20 sm:py-24 lg:py-32">
        <div class="mx-auto w-full max-w-[1600px] px-5 sm:px-8 lg:px-12">
          <h2 class="mb-10 font-serif text-4xl leading-[1.02] tracking-[-0.035em] text-neutral-950 sm:text-5xl lg:mb-14">
            Gallery
          </h2>
          <InstrumentGallery images={images.gallery} />
        </div>
      </section>
    )
  }

  {
    data.youtubeVideoId && (
      <section class="border-t border-neutral-200 py-20 sm:py-24 lg:py-32">
        <div class="mx-auto w-full max-w-[1200px] px-5 sm:px-8 lg:px-12">
          <h2 class="font-serif text-4xl leading-[1.02] tracking-[-0.035em] text-neutral-950 sm:text-5xl">
            Listen to this instrument
          </h2>
          <div class="mt-10">
            <YouTubeVideo
              videoId={data.youtubeVideoId}
              title={`${data.title} video`}
            />
          </div>
        </div>
      </section>
    )
  }

  <section class="border-t border-neutral-200 py-20 sm:py-24 lg:py-32">
    <div
      class="mx-auto grid w-full max-w-[1600px] gap-16 px-5 sm:px-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-24 lg:px-12"
    >
      <div>
        <h2 class="font-serif text-4xl tracking-[-0.03em] text-neutral-950">
          Details
        </h2>
      </div>

      <dl class="divide-y divide-neutral-200 border-t border-neutral-200">
        {
          specifications.map(([label, value]) => (
            <div class="grid gap-2 py-4 sm:grid-cols-[180px_1fr] sm:gap-8">
              <dt class="text-sm text-neutral-500">{label}</dt>
              <dd class="text-sm leading-relaxed text-neutral-950">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="border-t border-neutral-200 py-16 sm:py-20 lg:py-24">
    <div
      class="instrument-copy mx-auto w-full max-w-3xl px-5 text-lg leading-relaxed text-neutral-700 sm:px-8"
    >
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  :global(.instrument-copy > * + *) {
    margin-top: 1.25rem;
  }

  :global(.instrument-copy h2),
  :global(.instrument-copy h3) {
    font-family: "Times New Roman", Times, serif;
    color: #171717;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  :global(.instrument-copy h2) {
    margin-top: 3rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  :global(.instrument-copy h3) {
    margin-top: 2.25rem;
    font-size: 1.5rem;
  }
</style>
