---
import Container from "../components/layout/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getInstruments } from "../lib/instruments";
import { contactEmail, contactPhone, contactPhoneHref, contactLink } from "../lib/contact";
import { withBasePath } from "../lib/sitePaths";

const instrumentContexts = Object.fromEntries(
  (await getInstruments()).map(({ data }) => [
    data.slug,
    { title: data.title, status: data.status },
  ]),
);
const generalInquiryUrl = contactLink("Instrument enquiry", "Hello Shen Europe,\n\nI would like to ask about an instrument.\n");
const trialUrl = contactLink("Appointment in Berlin", "Hello Shen Europe,\n\nI would like to arrange a visit to try an available bass.\n");
const dealerUrl = contactLink("Trade enquiry", "Hello Shen Europe,\n\nI would like to contact you as a specialist dealer.\n\nCompany:\nLocation:\n");
---

<BaseLayout title="Contact | Shen Europe"
  description="Contact Shen Europe about a double bass, arrange an appointment to try an available instrument in Berlin, or make a trade enquiry."
>
  <section class="py-12 sm:py-16 lg:py-20">
    <Container>
      <h1 class="page-title text-neutral-950">Contact Shen Europe</h1>
      <p class="mt-6 max-w-2xl text-base leading-[1.8] text-neutral-600">
        Ask about an individual bass or arrange a time to try an available
        instrument in Berlin.
      </p>

      <div data-instrument-context data-instruments={JSON.stringify(instrumentContexts)}
        aria-live="polite" class="hidden mt-8 border-l-2 border-neutral-950 bg-neutral-50 p-6">
        <p data-context-label class="eyebrow">Your instrument enquiry</p>
        <h2 data-instrument-title class="subsection-title mt-3"></h2>
        <p data-instrument-status class="mt-3 text-sm font-medium"></p>
        <p data-context-note class="mt-3 max-w-2xl text-sm leading-relaxed text-neutral-600"></p>
        <div class="mt-5 flex flex-wrap gap-x-7 gap-y-3">
          <a href={generalInquiryUrl} data-instrument-contact class="quiet-link">
            {contactEmail ? "Enquire about this instrument" : "Call about this instrument"}
          </a>
          <a href={withBasePath("/available")} class="quiet-link">View available instruments</a>
        </div>
        {!contactEmail && <p class="mt-3 text-xs text-neutral-500">Please mention the instrument title when you call.</p>}
      </div>

      <div class="mt-10 grid gap-10 border-t border-neutral-200 pt-8 lg:grid-cols-2 lg:gap-20">
        <div>
          <h2 class="eyebrow">Direct contact</h2>
          <dl class="mt-6 space-y-7">
            {contactEmail && (
              <div>
                <dt class="text-sm text-neutral-500">Email</dt>
                <dd class="mt-2"><a href={`mailto:${contactEmail}`} class="quiet-link break-all">{contactEmail}</a></dd>
              </div>
            )}
            <div>
              <dt class="text-sm text-neutral-500">Telephone</dt>
              <dd class="mt-2"><a href={contactPhoneHref} class="text-lg underline decoration-neutral-300 underline-offset-4">{contactPhone}</a></dd>
            </div>
            <div>
              <dt class="text-sm text-neutral-500">Location</dt>
              <dd class="mt-2 text-base">Berlin · by appointment</dd>
            </div>
          </dl>
          {!contactEmail && <p class="mt-7 max-w-sm text-sm leading-relaxed text-neutral-600">Please call for instrument enquiries, appointments and trade enquiries.</p>}
        </div>

        <div>
          <section id="appointments" class="scroll-mt-28 border-b border-neutral-200 pb-8">
            <h2 class="subsection-title">Try an instrument in Berlin</h2>
            <p class="mt-4 text-base leading-[1.8] text-neutral-600">
              Let us know which available bass you would like to play,
              and we can arrange a time for your visit.
            </p>
            <a href={trialUrl} data-appointment-contact class="quiet-link mt-5">
              {contactEmail ? "Arrange an appointment" : "Call to arrange an appointment"}
            </a>
          </section>

          <section id="dealers" class="scroll-mt-28 pt-8">
            <h2 class="subsection-title">For specialist dealers</h2>
            <p class="mt-4 text-base leading-[1.8] text-neutral-600">
              If you are interested in Samuel Shen double basses for your
              business, contact us to discuss models, availability and working
              together.
            </p>
            <a href={dealerUrl} class="quiet-link mt-5">
              {contactEmail ? "Make a trade enquiry" : "Call for a trade enquiry"}
            </a>
          </section>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  import { contactEmail, contactLink } from "../lib/contact";
  import { resolveInstrumentInquiry } from "../lib/instrumentInquiry";
  const context = document.querySelector<HTMLElement>("[data-instrument-context]");
  const entries = JSON.parse(context?.dataset.instruments ?? "{}");
  const item = resolveInstrumentInquiry(entries, window.location.search);

  if (item && context) {
    const { similar } = item;
    const title = context.querySelector("[data-instrument-title]");
    const status = context.querySelector("[data-instrument-status]");
    const label = context.querySelector("[data-context-label]");
    const note = context.querySelector("[data-context-note]");
    const link = context.querySelector<HTMLAnchorElement>("[data-instrument-contact]");

    if (title) title.textContent = item.title;
    if (status) status.textContent = item.label;
    if (label) label.textContent = item.contextLabel;
    if (note) note.textContent = item.note;
    if (link) {
      link.textContent = contactEmail
        ? (similar ? "Ask about a similar instrument" : item.status === "unavailable" ? "Enquire about this reference" : "Enquire about this instrument")
        : (similar ? "Call about a similar instrument" : item.status === "unavailable" ? "Call about this reference" : "Call about this instrument");
      link.href = contactLink(
        (similar ? "Similar instrument enquiry: " : "Instrument enquiry: ") + item.title,
        "Hello Shen Europe,\n\nI would like to ask about " + (similar ? "an instrument similar to " : "") + item.title + ".\n",
      );
    }

    const appointment = document.querySelector<HTMLAnchorElement>("[data-appointment-contact]");
    if (appointment && item.canArrangeAppointment) {
      appointment.href = contactLink("Appointment: " + item.title,
        "Hello Shen Europe,\n\nI would like to try " + item.title + " in Berlin.\n");
    }
    document.querySelector("#appointments")?.classList.toggle("hidden", !item.canArrangeAppointment);
    context.classList.remove("hidden");
  }
</script>
