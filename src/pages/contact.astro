---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Shen Europe"
  description="Contact Shen Europe to arrange a trial, discuss an available instrument or place a special order."
>
  <section class="mx-auto max-w-[1600px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <h1
      class="font-serif max-w-4xl text-5xl leading-[0.98] tracking-[-0.04em] text-neutral-950 sm:text-6xl lg:text-7xl"
    >
      Contact
    </h1>

    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-neutral-700">
      Arrange a trial in Berlin, ask about an available instrument or discuss a
      special order.
    </p>
  </section>
</BaseLayout>
