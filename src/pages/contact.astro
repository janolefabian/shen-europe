---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Stack from "../components/layout/Stack.astro";
import Heading from "../components/ui/Heading.astro";
import Text from "../components/ui/Text.astro";
---

<BaseLayout
  title="Contact | Shen Europe"
  description="Contact Shen Europe to arrange a trial, discuss an available instrument or place a special order."
>
  <Section spacing="lg">
    <Stack gap="md" class="max-w-4xl">
      <Heading as="h1" size="xl">Contact</Heading>

      <Text size="lg" class="max-w-2xl">
        Arrange a trial in Berlin, ask about an available instrument or discuss a
        special order.
      </Text>
    </Stack>
  </Section>
</BaseLayout>
