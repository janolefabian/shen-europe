---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Container from "../components/layout/Container.astro";
import InstrumentPhoto from "../components/InstrumentPhoto.astro";
import { getInstrumentImages } from "../lib/instrumentImages";
import { getInstruments } from "../lib/instruments";
import { selectHomepageInstruments } from "../lib/instrumentAvailability";
import { withBasePath } from "../lib/sitePaths";

const homepageInstruments = selectHomepageInstruments(await getInstruments());
const featured = homepageInstruments[0];
const featuredImages = featured && getInstrumentImages(featured.filePath ?? featured.id, featured.data.title, featured.data);
const details = ["body-back", "tuning-machines-detail"].flatMap((category) => {
  const image = featuredImages?.gallery.find((image) => image.category === category);
  return image ? [image] : [];
});
---

<BaseLayout
  title="Shen Europe | Samuel Shen Double Basses"
  description="Samuel Shen double basses in Berlin. Explore individual instruments, arrange a visit and try a bass before buying."
>
  <Hero instruments={homepageInstruments} />

  {featured && details.length > 0 && (
    <section class="py-12 sm:py-16" aria-labelledby="instrument-details-title">
      <Container class="grid items-center gap-9 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div class="max-w-lg">
          <p class="eyebrow">{featured.data.title}</p>
          <h2 id="instrument-details-title" class="section-title mt-4">The instrument, in detail</h2>
          <p class="mt-5 text-base leading-[1.8] text-neutral-600">
            {featured.data.inventory === "BASS-0004"
              ? "The figured maple roundback and an individual tuning machine on this Panormo. These photographs show the same bass as the front view above."
              : "A closer view of the back and fitted components of this instrument. These are photographs of the bass itself, not a model example."}
          </p>
          <a href={withBasePath(`/instruments/${featured.data.slug}/`)} class="quiet-link mt-5">Photographs, equipment and playing notes</a>
        </div>
        <div class="grid grid-cols-2 items-start gap-4 sm:gap-6">
          {details.map((image) => (
            <figure>
              <a href={withBasePath(`/instruments/${featured.data.slug}/#gallery`)} aria-label={`View ${image.alt}`}>
                <InstrumentPhoto image={image} sizes="(min-width: 1024px) 260px, 42vw"
                  crop={featured.data.inventory === "BASS-0004" && image.category === "body-back"
                    ? { x: 50, y: 0, width: 1900, height: 2850 } : undefined} />
              </a>
              <figcaption class="mt-3 text-xs leading-relaxed text-neutral-500">
                {image.category === "body-back" ? "Back view" : "Tuning machine detail"}
              </figcaption>
            </figure>
          ))}
        </div>
      </Container>
    </section>
  )}

  <section class="border-t border-neutral-200 py-12 sm:py-16">
    <Container class="grid gap-10 md:grid-cols-2 md:gap-12 lg:gap-24">
      <div>
        <h2 class="section-title text-neutral-950">From Shen to the individual bass</h2>
        <p class="mt-5 max-w-lg text-base leading-[1.8] text-neutral-600">
          The instruments are made and set up by Shen in China. We import
          and sell them directly, with photographs and notes for each bass.
          Fully carved models lead the selection; hybrids and laminated
          instruments remain part of the wider range.
        </p>
        <a href={withBasePath("/about")} class="quiet-link mt-5">About Shen Europe</a>
      </div>

      <div>
        <h2 class="section-title text-neutral-950">Arrange a visit</h2>
        <p class="mt-5 max-w-lg text-base leading-[1.8] text-neutral-600">
          Photos and specifications are a starting point. Playing the bass
          lets you hear its response and find out how it feels in your hands.
          Contact us to discuss an instrument and arrange a time to visit.
        </p>
        <a href={withBasePath("/contact#appointments")} class="quiet-link mt-5">Contact for an appointment</a>
      </div>
    </Container>
  </section>
  <section class="border-t border-neutral-200 py-7">
    <Container class="flex flex-wrap items-baseline justify-between gap-4 text-sm text-neutral-600">
      <p>Enquiries from specialist dealers are also welcome.</p>
      <a href={withBasePath("/contact#dealers")} class="quiet-link">Trade contact</a>
    </Container>
  </section>
</BaseLayout>
