---
import type { CollectionEntry } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import InstrumentCard from "../components/InstrumentCard.astro";
import Hero from "../components/Hero.astro";
import Button from "../components/ui/Button.astro";
import { getInstruments } from "../lib/instruments";

const orderByPriority = (
  a: CollectionEntry<"instruments">,
  b: CollectionEntry<"instruments">,
) => a.data.order - b.data.order;
const availableInstruments = (await getInstruments())
  .filter((instrument) => instrument.data.status !== "sold")
  .sort(orderByPriority);
const featuredInstruments = availableInstruments.filter(
  (instrument) => instrument.data.featured,
);
const homepageInstruments = (
  featuredInstruments.length > 0 ? featuredInstruments : availableInstruments
).slice(0, 2);
---

<BaseLayout
  title="Shen Europe | Samuel Shen Double Basses"
  description="Samuel Shen double basses selected in Suzhou and set up in Berlin."
>
  <Hero />

  <section class="border-t border-neutral-200 py-20 sm:py-24 lg:py-32">
    <div class="mx-auto w-full max-w-[1600px] px-5 sm:px-8 lg:px-12">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-24">
        <div>
          <p class="text-sm tracking-[0.1em] text-neutral-500 uppercase">
            Selection and setup
          </p>
          <h2 class="mt-4 max-w-xl font-serif text-4xl leading-[1.05] tracking-[-0.035em] text-neutral-950 sm:text-5xl">
            Selected in Suzhou and set up in Berlin
          </h2>
        </div>

        <div class="grid gap-10 sm:grid-cols-3 sm:gap-6 lg:gap-10">
          <div class="border-t border-neutral-200 pt-5">
            <p class="text-xs tracking-[0.1em] text-neutral-500 uppercase">
              01
            </p>
            <h3 class="mt-4 font-serif text-2xl tracking-[-0.02em] text-neutral-950">
              Selected in Suzhou
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-neutral-600">
              We compare individual instruments for response, character and
              workmanship.
            </p>
          </div>

          <div class="border-t border-neutral-200 pt-5">
            <p class="text-xs tracking-[0.1em] text-neutral-500 uppercase">
              02
            </p>
            <h3 class="mt-4 font-serif text-2xl tracking-[-0.02em] text-neutral-950">
              Prepared in Berlin
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-neutral-600">
              Each bass is inspected and set up before trial or delivery.
            </p>
          </div>

          <div class="border-t border-neutral-200 pt-5">
            <p class="text-xs tracking-[0.1em] text-neutral-500 uppercase">
              03
            </p>
            <h3 class="mt-4 font-serif text-2xl tracking-[-0.02em] text-neutral-950">
              Available in Europe
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-neutral-600">
              Instruments can be tried in Berlin or delivered within Europe.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    homepageInstruments.length > 0 && (
      <section class="border-t border-neutral-200 bg-neutral-50 py-20 sm:py-24 lg:py-32">
        <div class="mx-auto w-full max-w-[1600px] px-5 sm:px-8 lg:px-12">
          <div class="flex flex-col gap-7 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-sm tracking-[0.1em] text-neutral-500 uppercase">
                Currently in Berlin
              </p>
              <h2 class="mt-4 font-serif text-4xl leading-[1.05] tracking-[-0.035em] text-neutral-950 sm:text-5xl">
                Available for trial
              </h2>
            </div>

            <Button href="/available" variant="text">
              View all instruments
            </Button>
          </div>

          <div class="mt-12 grid max-w-6xl gap-x-8 gap-y-20 lg:grid-cols-2">
            {homepageInstruments.map((instrument) => (
              <InstrumentCard instrument={instrument} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="border-t border-neutral-200 py-16 sm:py-20 lg:py-24">
    <div class="mx-auto grid w-full max-w-[1600px] gap-8 px-5 sm:px-8 lg:grid-cols-[1fr_auto] lg:items-end lg:px-12">
      <div class="max-w-3xl">
        <p class="text-sm tracking-[0.1em] text-neutral-500 uppercase">
          Trials and special orders
        </p>
        <h2 class="mt-4 font-serif text-4xl leading-[1.05] tracking-[-0.03em] text-neutral-950 sm:text-5xl">
          Trial in Berlin or special order
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-600">
          Arrange a trial or tell us which model, dimensions and setup you are
          looking for.
        </p>
      </div>

      <Button href="/contact" variant="outline" size="lg">
        Get in touch
      </Button>
    </div>
  </section>
</BaseLayout>
