---
import { Image } from "astro:assets";
import Container from "../components/layout/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import stackedBodies from "../assets/suzhou/stacked-bodies.png";
import bassesBeforeVarnishing from "../assets/suzhou/basses-before-varnishing.png";
import samuelAtWorkbench from "../assets/archive/samuel-shen-at-workbench.jpg";
import { withBasePath } from "../lib/sitePaths";
---

<BaseLayout
  title="About Shen Europe | From Shen to Berlin"
  description="Samuel Shen double basses, made and set up in China, imported and sold by Shen Europe in Berlin. About the instruments and arranging a visit."
>
  <section class="py-12 sm:py-16 lg:py-20">
    <Container class="about-intro">
      <div>
        <p class="eyebrow">Origin and instruments</p>
        <h1 class="page-title mt-4 text-neutral-950">About Shen Europe</h1>
        <p class="mt-7 max-w-xl text-base leading-[1.8] text-neutral-600">
          Shen Europe imports and sells Samuel Shen double basses from Berlin.
          Our focus is on individual instruments that you can try in person
          before deciding to buy.
        </p>
        <p class="mt-5 max-w-xl text-base leading-[1.8] text-neutral-600">
          The focus is on fully carved basses, with hybrid and laminated
          instruments also part of the wider Shen range. Current availability
          is shown against each individual bass, separately from model information.
        </p>
      </div>
      <figure class="suzhou-photo" data-suzhou-photo="stacked-bodies">
        <Image src={stackedBodies} alt="Unfinished double bass bodies stacked in rows at Shen in Suzhou"
          widths={[480, 800, 1200, 1706]} sizes="(min-width: 1280px) 640px, (min-width: 768px) 52vw, 100vw"
          format="webp" quality={82} loading="eager" fetchpriority="high" class="block h-auto w-full" />
        <figcaption>Unfinished bodies at Shen in Suzhou.</figcaption>
      </figure>
    </Container>
  </section>

  <section id="samuel-shen" aria-labelledby="samuel-shen-title" class="samuel-section py-12 sm:py-16">
    <Container class="samuel-story">
      <div class="samuel-copy">
        <p class="eyebrow">The maker</p>
        <h2 id="samuel-shen-title" class="section-title mt-3 text-neutral-950">Samuel Shen</h2>
        <div class="mt-5 space-y-4 text-base leading-[1.8] text-neutral-600">
          <p>
            Samuel Shen trained as a violin maker in Canada, where he also
            ran his own workshop.
          </p>
          <p>
            He later returned to China and established the company that
            produces Shen instruments today.
          </p>
        </div>
      </div>
      <figure class="archive-photo" data-archive-photo="samuel-at-workbench">
        <Image src={samuelAtWorkbench}
          alt="Samuel Shen working on an instrument at the workbench in an undated archival photograph"
          widths={[400, 640, 960, 1200]} sizes="(min-width: 768px) 448px, (min-width: 488px) 448px, calc(100vw - 40px)"
          format="webp" quality={85} loading="lazy" class="block h-auto w-full" />
        <figcaption>Samuel Shen at the workbench. Undated archival photograph.</figcaption>
      </figure>
    </Container>
  </section>

  <section id="suzhou" aria-labelledby="suzhou-title" class="py-12 sm:py-16">
    <Container class="suzhou-story">
      <div>
        <h2 id="suzhou-title" class="section-title text-neutral-950">Shen in Suzhou</h2>
        <div class="mt-5 max-w-xl space-y-5 text-base leading-[1.8] text-neutral-600">
          <p>
            Shen produces the instruments in China. The range includes
            basses with carved solid-wood tops and backs and solid-wood ribs,
            hybrids with a carved top and laminated back and ribs, and laminated basses.
            Body pattern, materials and specification level are separate choices;
            a model name alone does not describe every detail of an instrument.
          </p>
          <p>
            For the instruments supplied to Shen Europe so far, the setup has
            been carried out by Shen in China. In Berlin, the existing bridges
            were stood up and strings were fitted. The instrument pages distinguish
            documented equipment and playing observations from model-reference specifications.
          </p>
          <a href={withBasePath("/models")} class="quiet-link">Construction and model levels</a>
        </div>
      </div>
      <figure class="suzhou-photo" data-suzhou-photo="basses-before-varnishing">
        <Image src={bassesBeforeVarnishing} alt="Unfinished double basses with necks and scrolls at Shen in Suzhou"
          widths={[480, 800, 1200, 1706]} sizes="(min-width: 1280px) 620px, (min-width: 768px) 48vw, 100vw"
          format="webp" quality={82} loading="lazy" class="block h-auto w-full" />
        <figcaption>Double basses before varnishing, Suzhou. Photograph supplied by Shen.</figcaption>
      </figure>
    </Container>
  </section>

  <section id="shen-in-the-us" aria-labelledby="shen-in-the-us-title" class="border-t border-neutral-200 py-12 sm:py-16">
    <Container class="grid gap-6 md:grid-cols-2 lg:gap-24">
      <h2 id="shen-in-the-us-title" class="section-title text-neutral-950">Shen in the United States</h2>
      <div class="us-context max-w-xl space-y-5 text-base leading-[1.8] text-neutral-600">
        <p>
          Samuel Shen double basses are represented in the United States by{" "}
          <a href="https://cscproducts.com/">CSC Products</a>{" "}
          and sold through specialist instrument shops.
        </p>
        <p>
          In its published comments on the Shen range, US dealer{" "}
          <a href="https://www.brucewallacebass.com/basssales">Wallace Bass Shop</a>{" "}
          highlights the instruments’ design, workmanship and seasoned wood.
        </p>
      </div>
    </Container>
  </section>

  <section class="bg-[#191919] py-12 text-white sm:py-16">
    <Container>
        <h2 class="section-title">From the instrument to your visit</h2>
        <div class="journey-steps">
          <div>
            <h3 class="subsection-title">Arrival</h3>
            <p class="mt-3 text-base leading-[1.8] text-neutral-300">
              We import the basses from Shen. An instrument on the way is not
              available to play yet. Available, incoming, reserved and sold
              instruments are kept separate in the listings.
            </p>
          </div>
          <div>
            <h3 class="subsection-title">The individual bass</h3>
            <p class="mt-3 text-base leading-[1.8] text-neutral-300">
              Front and back views, details of the fittings, and notes about the
              particular bass help you prepare for a visit. Playing impressions
              describe that instrument, not every bass carrying the same model number.
            </p>
          </div>
          <div>
            <h3 class="subsection-title">An appointment in Berlin</h3>
            <p class="mt-3 text-base leading-[1.8] text-neutral-300">
              Contact us about an available bass and arrange a time to play it.
              You do not need to fit a professional category: the relevant questions
              are how you play, what you need and how the instrument feels to you.
            </p>
          </div>
        </div>
    </Container>
  </section>

  <section class="py-12 sm:py-16">
    <Container class="grid gap-6 md:grid-cols-2 lg:gap-24">
      <h2 class="section-title text-neutral-950">What a model number cannot tell you</h2>
      <div class="max-w-xl space-y-5 text-base leading-[1.8] text-neutral-600">
        <p>
          Instruments built to the same specification can differ in response,
          sound and feel. A model level describes materials and construction;
          it cannot decide which bass suits a particular player.
        </p>
        <p>
          The dimensions and photographs help you compare instruments.
          An appointment gives you the opportunity to hear and play the bass
          itself, with your own musical requirements in mind.
        </p>
        <a href={withBasePath("/available")} class="quiet-link">Explore available instruments</a>
      </div>
    </Container>
  </section>

  <section class="border-t border-neutral-200 py-8">
    <Container class="flex flex-wrap items-baseline justify-between gap-4 text-sm text-neutral-600">
      <p>Specialist dealers are welcome to contact Shen Europe directly.</p>
      <a href={withBasePath("/contact#dealers")} class="quiet-link">Trade enquiries</a>
    </Container>
  </section>
</BaseLayout>

<style>
  /* Container renders these roots without forwarding this page's scope attribute. */
  :global(.about-intro), :global(.samuel-story), :global(.suzhou-story) {
    display: grid; align-items: center; gap: 2.5rem;
  }
  .suzhou-photo, .archive-photo { min-width: 0; width: 100%; }
  .suzhou-photo figcaption, .archive-photo figcaption {
    margin-top: .75rem; color: #737373; font-size: .75rem; line-height: 1.6;
  }
  .samuel-section { background: #f6f6f6; }
  .archive-photo { max-width: 28rem; }
  .samuel-copy { max-width: 30rem; }
  #samuel-shen, #shen-in-the-us { scroll-margin-top: 7rem; }
  .us-context a { color: #171717; text-decoration: underline; text-decoration-color: #c4c4c4; text-underline-offset: .2em; }
  .us-context a:hover { text-decoration-color: currentColor; }
  .us-context a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .journey-steps { display: grid; gap: 1.75rem; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #404040; }
  @media (min-width: 768px) {
    :global(.about-intro), :global(.samuel-story), :global(.suzhou-story) {
      grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); gap: 3rem;
    }
    .samuel-copy { grid-column: 2; grid-row: 1; }
    .archive-photo { grid-column: 1; grid-row: 1; }
  }
  @media (min-width: 1024px) {
    :global(.samuel-story), :global(.suzhou-story) { column-gap: 5rem; }
    .journey-steps { grid-template-columns: repeat(3, minmax(0,1fr)); gap: 3rem; }
  }
</style>
